# HAMi — hard, uneven single-GPU memory partitioning (STAGED, NOT YET ACTIVE)
#
# ============================ .yaml.hold = PARKED ============================
# Flux IGNORES this file while it ends in .hold. Activate ONLY during the
# end-of-run idle window, following HAMI-SWAP-RUNBOOK.md at the repo root.
# Activating means: (1) remove the stock plugin (prereqs/nvidia-device-plugin.yaml),
# (2) rename this file .hold -> .yaml. Do NOT do this under a live GPU workload.
# =============================================================================
#
# WHY: the stock NVIDIA device plugin can only do an EVEN total/replicas memory
# cap (can't give training 86GB + inference 8GB). HAMi's libvgpu.so intercepts
# CUDA/NVML so each pod sees ONLY its nvidia.com/gpumem quota as "total" VRAM ->
# arbitrary UNEVEN HARD memory caps, no retrain. Proven on RTX PRO 6000 Blackwell
# + driver 580.x + CUDA 13 (HAMi #2015). See memory: project_gpu_sharing_hami_plan.
#
# VERIFIED against the live cluster (talos-210-73x): Talos v1.13.6, k8s v1.36.2,
# containerd 2.2.5, cert-manager present, CDI live at /var/run/cdi/nvidia.yaml,
# node label feature.node.kubernetes.io/pci-10de.present=true.
#
# TALOS-CRITICAL overrides (else it fails on read-only /usr/local):
#   - gpuHookPath -> /var/lib/hami (writable), libPath + monitor.ctrPath under it.
#   - kube-scheduler image -> registry.k8s.io (Aliyun default lacks v1.36.2);
#     tag MUST equal the control-plane minor (v1.36.2). Bump on every k8s upgrade.
#   - runtimeClassName: nvidia (NVML sees the driver via the nvidia runtime/CDI);
#     nvidiaDriverRoot left null on purpose.
#   - webhook certs via cert-manager (present) not the ancient built-in certgen.
#
# CAVEATS: gpucores (compute) capping is UNRELIABLE on Blackwell (NVML per-process
# SM-util API gap, no driver fixes it) -> leave compute UNCAPPED (never set gpucores).
# Memory isolation is the trustworthy part and is what we need.
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: hami
  namespace: flux-system
spec:
  interval: 1h
  url: https://project-hami.github.io/HAMi/
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: hami
  namespace: kube-system
spec:
  interval: 5m
  chart:
    spec:
      chart: hami
      # VERIFY exact chart semver against the repo index at swap time
      # (`helm search repo hami/hami --versions`); HAMi chart version may differ
      # from the v2.9.0 app version. Pin whatever the index reports for v2.9.0+.
      version: "2.9.0"
      sourceRef:
        kind: HelmRepository
        name: hami
        namespace: flux-system
      interval: 5m
  values:
    schedulerName: "hami-scheduler"

    global:
      # /usr/local is READ-ONLY on Talos -> move the libvgpu.so hook dir under /var.
      gpuHookPath: /var/lib/hami

    scheduler:
      kubeScheduler:
        enabled: true          # bundled 2nd scheduler + extender (ideal on Talos)
        image:
          registry: registry.k8s.io     # Aliyun default mirror lacks v1.36.2
          repository: kube-scheduler
          tag: "v1.36.2"                 # MUST equal control-plane minor (k8s v1.36.2)
      admissionWebhook:
        enabled: true
        certManager:
          enabled: true        # cert-manager is present in kube-system
      # leaderElect true / replicas 1 is fine on one node (SPOF only affects
      # scheduling NEW gpu pods; running pods unaffected).

    devicePlugin:
      runtimeClassName: nvidia          # run the DS under the nvidia runtime -> NVML init works
      createRuntimeClass: false         # RuntimeClass "nvidia" already exists
      libPath: /var/lib/hami/vgpu       # must equal gpuHookPath + /vgpu
      monitor:
        ctrPath: /var/lib/hami/vgpu/containers   # also defaults under /usr/local -> move
      nvidiaNodeSelector:               # reuse the existing label (no new label needed)
        feature.node.kubernetes.io/pci-10de.present: "true"
      deviceSplitCount: 10              # up to 10 pods/card; we need 2
      deviceMemoryScaling: 1            # hard isolation, NO oversubscription (pool = physical 96GB)
      # nvidiaDriverRoot: null          # intentionally unset; runtime/CDI injects driver libs

    prometheus:
      enabled: true                     # ServiceMonitor -> per-pod hami_container_memory_* metrics
