# Muse-Glimmer-30B  ->  AutoRound NVFP4 (W4A4)  ->  compressed-tensors, for vLLM on SM120.
#
# Goal: a reproducible text-only NVFP4 quant of meta-models/Muse-Glimmer-30B — quantize the
# text-decoder Linear modules to NVFP4 W4A4, keep vision tower/adapter/projection + embed_tokens
# + lm_head in BF16 — exported as llm_compressor / compressed-tensors (format nvfp4-pack-quantized).
# Plan/rationale: the AutoRound handoff bundle + our review (GitHub notes).
#
# WHY A JOB (not the bundle's bare-metal `uv` flow): this is a Talos/K8s node — no SSH host next
# to the GPU. Runs as a GitOps-managed Job with runtimeClassName nvidia + nvidia.com/gpu: 1.
#
# GPU: needs the WHOLE 96GB card (device_map=0). apps/vllm-stack.yaml qwen27 is scaled to 0 so the
# GPU is free; the endpoint is intentionally DOWN while this runs (user-approved).
#
# STORAGE: workspace PVC on `local-path` = NVMe (/var/lib/local-path-provisioner). Holds the ~60GB
# BF16 base download (HF_HOME), calibration data, and the ~25-35GB NVFP4 output. NOT the HDD.
#
# TOOLCHAIN: base = vllm/vllm-openai:v0.26.0 (its torch already targets SM120 — it serves NVFP4 on
# this exact card). auto-round is pip-installed at runtime from the dbirks/auto-round fork's main
# (has the post-0.14.2 opt_rtn NVFP4 fix, PR #2100). A "separate quant env from serving" per the bundle.
#
# FLOW: (1) preflight Job below — cheap gate, no big download: does Muse load, is it detected as an
# MLLM, what's the Linear module map, is it dense (not MoE), is SM120 visible. Review artifacts, THEN
# (2) add the quantize Job (smoke -> default) in a follow-up commit.
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: muse-quant-workspace
  namespace: default
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: local-path   # NVMe (/var/lib/local-path-provisioner), per user
  resources:
    requests:
      storage: 120Gi
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: muse-quant-scripts
  namespace: default
data:
  prep.sh: |
    #!/bin/bash
    # Install the quant toolchain into the vLLM image, then run a stage. torch is left ALONE
    # (auto-round requires torch unpinned -> pip sees the image's SM120 build as satisfied).
    set -euo pipefail
    PY="$(command -v python3 || command -v python)"   # vllm image ships python3, not python
    export HF_HOME=/workspace/hf
    export PYTHONUNBUFFERED=1
    export TOKENIZERS_PARALLELISM=false
    mkdir -p /workspace/artifacts /workspace/runs "$HF_HOME"
    echo "=== [$(date)] python=$PY torch BEFORE install ==="
    "$PY" -c "import torch;print('torch',torch.__version__,'cuda?',torch.cuda.is_available())" || true
    echo "=== [$(date)] ensuring git (auto-round build invokes it) ==="
    if ! command -v git >/dev/null 2>&1; then
      (apt-get update -qq && apt-get install -y -qq git) >/dev/null 2>&1 || true
    fi
    if command -v git >/dev/null 2>&1; then
      AR_SPEC="auto-round @ git+https://github.com/dbirks/auto-round.git@main"   # clone carries .git -> setuptools_scm ok
    else
      echo "WARN: git unavailable; falling back to PyPI auto-round wheel (lacks post-0.14.2 opt_rtn NVFP4 fix)"
      AR_SPEC="auto-round"
    fi
    echo "=== [$(date)] installing ${AR_SPEC} + deps ==="
    "$PY" -m pip install --no-cache-dir "$AR_SPEC" datasets accelerate 2>&1 | tail -15
    # Muse (model_type muse_glimmer) is newer than the pinned transformers release and has no
    # auto_map (not a remote-code model) -> install transformers from source so the arch is known.
    echo "=== [$(date)] installing transformers from source (for muse_glimmer arch) ==="
    "$PY" -m pip install --no-cache-dir --upgrade "git+https://github.com/huggingface/transformers.git" 2>&1 | tail -8
    "$PY" -c "import transformers; print('transformers', transformers.__version__)"
    echo "=== [$(date)] torch AFTER install (must still import) ==="
    "$PY" -c "import torch;print('torch',torch.__version__,'cuda?',torch.cuda.is_available())" || true
    "$PY" -m pip freeze 2>/dev/null > /workspace/artifacts/pip-freeze.txt || true
    echo "=== [$(date)] running stage: ${1:-preflight} ==="
    case "${1:-preflight}" in
      preflight)
        "$PY" /scripts/preflight.py ;;
      quantize)
        export QUANT_MODE=smoke;   "$PY" /scripts/quantize.py
        export QUANT_MODE=default; "$PY" /scripts/quantize.py ;;
      quantize-default)
        export QUANT_MODE=default; "$PY" /scripts/quantize.py ;;
      *) echo "unknown stage ${1:-}"; exit 2 ;;
    esac
    echo "=== [$(date)] stage ${1:-preflight} complete ==="
  preflight.py: |
    #!/usr/bin/env python3
    """Non-destructive preflight: CUDA/SM120, package provenance, Muse config/processor load,
    AutoRound API + MLLM module-path probe, and a META-DEVICE Linear inventory (no weights,
    no GPU/RAM). Writes /workspace/artifacts/{muse-preflight.json, muse-linear-module-inventory.tsv}."""
    import inspect, importlib, json, os, platform
    from importlib.metadata import version as _v
    from pathlib import Path

    MODEL = os.environ.get("MUSE_MODEL", "meta-models/Muse-Glimmer-30B")
    ART = Path(os.environ.get("ARTIFACTS", "/workspace/artifacts")); ART.mkdir(parents=True, exist_ok=True)
    R = {"model_id": MODEL, "python": platform.python_version(), "platform": platform.platform()}

    def ver(d):
        try: return _v(d)
        except Exception as e: return f"unknown({e!r})"
    R["versions"] = {m: ver(m) for m in
        ["torch","transformers","auto-round","compressed-tensors","llmcompressor","datasets","safetensors","accelerate"]}

    try:
        import torch
        R["cuda"] = {"available": torch.cuda.is_available(), "torch": torch.__version__, "torch_cuda": torch.version.cuda}
        if torch.cuda.is_available():
            p = torch.cuda.get_device_properties(0)
            R["cuda"].update(name=torch.cuda.get_device_name(0),
                             cc=list(torch.cuda.get_device_capability(0)),
                             vram_gib=round(p.total_memory/1024**3, 1))
    except Exception as e:
        R["cuda_error"] = repr(e)

    try:
        import auto_round
        from auto_round import AutoRound
        R["auto_round"] = {"file": auto_round.__file__,
                           "version": getattr(auto_round, "__version__", "?"),
                           "signature": str(inspect.signature(AutoRound))}
    except Exception as e:
        R["auto_round_error"] = repr(e)

    # Which package layout has the MLLM template/processor API (auto_round.mllm.* vs .compressors.mllm.*)?
    for kind, cands in {
        "mllm_template_module": ["auto_round.mllm.template", "auto_round.compressors.mllm.template"],
        "mllm_processor_module": ["auto_round.mllm.processor", "auto_round.compressors.mllm.processor"],
    }.items():
        R[kind] = "NOT-FOUND"
        for c in cands:
            try:
                importlib.import_module(c); R[kind] = c; break
            except Exception:
                pass

    try:
        from transformers import AutoConfig
        cfg = AutoConfig.from_pretrained(MODEL, trust_remote_code=True)
        R["hf_config"] = {"class": cfg.__class__.__name__,
                          "model_type": getattr(cfg, "model_type", None),
                          "architectures": getattr(cfg, "architectures", None),
                          "auto_map": getattr(cfg, "auto_map", None),
                          "has_text_config": hasattr(cfg, "text_config"),
                          "has_vision_config": hasattr(cfg, "vision_config")}
        tc = getattr(cfg, "text_config", cfg)
        moe = {k: getattr(tc, k) for k in
               ["num_experts","n_routed_experts","num_local_experts","num_experts_per_tok","moe_intermediate_size"]
               if hasattr(tc, k)}
        R["moe_hints"] = moe or "none (looks dense)"
    except Exception as e:
        R["hf_config_error"] = repr(e)

    try:
        from transformers import AutoProcessor
        proc = AutoProcessor.from_pretrained(MODEL, trust_remote_code=True)
        R["hf_processor"] = {"class": proc.__class__.__name__}
    except Exception as e:
        R["hf_processor_error"] = repr(e)

    # Meta-device module inventory: build the module tree with NO real weights (no GPU/RAM needed).
    try:
        import torch
        import transformers as tf
        from accelerate import init_empty_weights
        from transformers import AutoConfig
        cfg = AutoConfig.from_pretrained(MODEL, trust_remote_code=True)
        loaders = [n for n in ["AutoModelForImageTextToText","AutoModelForVision2Seq","AutoModelForCausalLM"] if hasattr(tf, n)]
        model, used, errs = None, None, {}
        for n in loaders:
            try:
                with init_empty_weights():
                    model = getattr(tf, n).from_config(cfg, trust_remote_code=True)
                used = n; break
            except Exception as e:
                errs[n] = repr(e)[:200]
        if model is None:
            R["meta_inventory_error"] = errs
        else:
            R["meta_loader"] = used
            rows, g = [], {"text": [], "vision": [], "head_embed": [], "other": []}
            for name, m in model.named_modules():
                if isinstance(m, torch.nn.Linear):
                    rows.append(f"{name}\t{m.in_features}\t{m.out_features}\t{m.bias is not None}")
                    l = name.lower()
                    if "vision" in l: g["vision"].append(name)
                    elif "lm_head" in l or "embed_tokens" in l: g["head_embed"].append(name)
                    elif ".layers." in name: g["text"].append(name)
                    else: g["other"].append(name)
            (ART/"muse-linear-module-inventory.tsv").write_text("name\tin\tout\tbias\n"+"\n".join(rows)+"\n")
            R["linear_counts"] = {k: len(v) for k, v in g.items()}
            R["other_linears_sample"] = g["other"][:50]  # unclassified Linears — REVIEW before quantizing
    except Exception as e:
        R["meta_inventory_error"] = repr(e)

    (ART/"muse-preflight.json").write_text(json.dumps(R, indent=2, default=str))
    print(json.dumps(R, indent=2, default=str))
    print("\nPREFLIGHT_ERRORS:", [k for k in R if k.endswith("_error")])
    if "hf_config_error" in R:
        raise SystemExit("FATAL: cannot load Muse config — resolve model availability/gating/transformers support first.")
  quantize.py: |
    #!/usr/bin/env python3
    """AutoRound NVFP4 (W4A4) quant of Muse text decoder -> llm_compressor/compressed-tensors.
    QUANT_MODE in {smoke,default,best}. Verifies the export is nvfp4-pack-quantized."""
    import importlib, json, os
    from pathlib import Path

    MODEL  = os.environ.get("MUSE_MODEL", "meta-models/Muse-Glimmer-30B")
    MODE   = os.environ.get("QUANT_MODE", "smoke")
    SCHEME = os.environ.get("QUANT_SCHEME", "NVFP4")   # NVFP4 (W4A4, Blackwell) | W4A16 (int4 weight-only, any GPU)
    RUN_TAG = os.environ.get("RUN_TAG", "")            # output-name suffix, e.g. "-mp1" for a mixed-precision variant
    CALIB  = os.environ.get("CALIB_DATASET", "NeelNanda/pile-10k")
    ART    = Path(os.environ.get("ARTIFACTS", "/workspace/artifacts"))
    OUT    = Path(os.environ.get("QUANT_OUT", f"/workspace/runs/Muse-Glimmer-30B-{SCHEME}{RUN_TAG}-AutoRound-{MODE}"))
    ART.mkdir(parents=True, exist_ok=True); OUT.mkdir(parents=True, exist_ok=True)

    MODES = {
        "smoke":   dict(nsamples=8,   seqlen=512,  batch_size=1, iters=0,    low_gpu_mem_usage=False),
        "default": dict(nsamples=128, seqlen=2048, batch_size=4, iters=200,  low_gpu_mem_usage=False),
        "best":    dict(nsamples=512, seqlen=2048, batch_size=4, iters=1000, low_gpu_mem_usage=True),
    }
    if MODE not in MODES: raise SystemExit(f"bad QUANT_MODE={MODE}")
    P = MODES[MODE]
    print(f"=== quantize SCHEME={SCHEME} MODE={MODE} params={P} model={MODEL} -> {OUT} ===", flush=True)

    import torch  # noqa
    from auto_round import AutoRound
    from transformers import AutoConfig
    cfg = AutoConfig.from_pretrained(MODEL, trust_remote_code=True)
    print("model_type:", getattr(cfg, "model_type", None), "arch:", getattr(cfg, "architectures", None), flush=True)

    # Optional selective higher-precision for W4A4 activation-outlier modules (e.g. mlp.down_proj).
    # EXEMPT_MODULES="down_proj,up_proj" raises those mlp modules' act_bits (weights stay SCHEME
    # unless EXEMPT_W_BITS set). 52 text-decoder layers confirmed via preflight inventory.
    layer_config = {}
    _exempt = os.environ.get("EXEMPT_MODULES", "").strip()
    if _exempt:
        _tc = getattr(cfg, "text_config", cfg)
        _nl = int(getattr(_tc, "num_hidden_layers", None) or getattr(cfg, "num_hidden_layers", None) or 52)
        _ab = int(os.environ.get("EXEMPT_ACT_BITS", "8"))
        _wb = os.environ.get("EXEMPT_W_BITS", "").strip()
        for _i in range(_nl):
            for _m in [x.strip() for x in _exempt.split(",") if x.strip()]:
                _e = {"act_bits": _ab}
                if _wb:
                    _e["bits"] = int(_wb)
                layer_config[f"model.language_model.layers.{_i}.mlp.{_m}"] = _e
        print(f"layer_config: {len(layer_config)} modules exempted (act_bits={_ab}" + (f", bits={_wb}" if _wb else "") + ")", flush=True)

    def make(**extra):
        kw = dict(scheme=SCHEME, dataset=CALIB, device_map=0, trust_remote_code=True,
                  quant_nontext_module=False, seed=42, **P, **extra)
        if layer_config:
            kw["layer_config"] = layer_config
        return AutoRound(MODEL, **kw)

    try:
        ar = make()
    except Exception as e:
        print("AutoRound init failed; trying MLLM template registration:", repr(e)[:400], flush=True)
        reg = procs = None
        for tmod, pmod in [("auto_round.mllm.template", "auto_round.mllm.processor"),
                           ("auto_round.compressors.mllm.template", "auto_round.compressors.mllm.processor")]:
            try:
                reg = importlib.import_module(tmod)._register_template
                procs = importlib.import_module(pmod).PROCESSORS
                break
            except Exception:
                continue
        if reg is None: raise
        reg(model_type=cfg.model_type, default_dataset=CALIB, processor=procs["hf"])
        print("registered MLLM template for", cfg.model_type, flush=True)
        ar = make()

    _, saved = ar.quantize_and_save(output_dir=str(OUT), format="llm_compressor")
    print("Saved:", saved, flush=True)

    # AutoRound writes into a nested subdir (e.g. OUT/<model>-nvfp-w4g16). Resolve the real
    # artifact dir from the returned path, with rglob + OUT fallbacks.
    def _find_cfg(base):
        base = Path(base)
        if (base / "config.json").is_file():
            return base
        for p in sorted(base.rglob("config.json")):
            return p.parent
        return None
    cand = saved[0] if isinstance(saved, (list, tuple)) else saved
    SAVED = _find_cfg(cand) if cand else None
    SAVED = SAVED or _find_cfg(OUT)
    if SAVED is None:
        raise SystemExit(f"FATAL: no config.json found under {cand!r} or {OUT}")
    print("resolved artifact dir:", SAVED, flush=True)
    (ART / f"artifact-path-{SCHEME}-{MODE}.txt").write_text(str(SAVED) + "\n")

    c = json.loads((SAVED / "config.json").read_text())
    qc = c.get("quantization_config") or c.get("text_config", {}).get("quantization_config")
    (ART / f"quant-config-{SCHEME}-{MODE}.json").write_text(json.dumps(qc, indent=2, default=str))
    print("quantization_config:\n", json.dumps(qc, indent=2, default=str)[:2000], flush=True)
    fmt = (qc or {}).get("format")
    wbits = (((qc or {}).get("config_groups", {}).get("group_0", {}) or {}).get("weights", {}) or {}).get("num_bits")
    print(f"format={fmt} weight_bits={wbits}", flush=True)
    if not qc or wbits != 4:
        raise SystemExit(f"FATAL: expected 4-bit weights, got num_bits={wbits} (format {fmt})")
    print(f"OK [{SCHEME}/{MODE}]: {fmt} export verified at {SAVED}", flush=True)

    # Post-fix: HF's config parser requires config_groups.*.format to be a STRING; AutoRound writes
    # it as null -> "Configuration Parsing Warning" on the model page. Set it to the top-level format.
    try:
        _cp = SAVED / "config.json"
        _cc = json.loads(_cp.read_text())
        _q = _cc.get("quantization_config") or (_cc.get("text_config") or {}).get("quantization_config") or {}
        _top = _q.get("format")
        _patched = False
        for _g in (_q.get("config_groups") or {}).values():
            if _g.get("format") in (None, ""):
                _g["format"] = _top; _patched = True
        if _patched:
            _cp.write_text(json.dumps(_cc, indent=2))
            print(f"post-fix: config_groups.*.format -> {_top}", flush=True)
    except Exception as _e:
        print("post-fix skipped:", repr(_e), flush=True)
---
# Quantize Job: runs smoke (nsamples 8, iters 0 — validate download+calibration+packing+export)
# then default (nsamples 128, iters 200 — the real artifact). Preflight GREEN gated this:
# Muse loads (transformers-from-source), dense (SM120-safe), clean text/vision/head module map.
# HF_HOME on the PVC so the ~60GB BF16 base downloads ONCE and re-runs reuse it.
apiVersion: batch/v1
kind: Job
metadata:
  name: muse-quant-run-20260811b
  namespace: default
spec:
  backoffLimit: 0               # long, expensive GPU run — never auto-retry; fix + re-fire by name bump
  activeDeadlineSeconds: 28800  # up to 8h: ~60GB download + smoke + default (iters 200)
  template:
    spec:
      restartPolicy: Never
      runtimeClassName: nvidia
      enableServiceLinks: false     # avoid the `vllm` Service injecting VLLM_* env into this pod
      priorityClassName: system-node-critical
      containers:
        - name: quantize
          image: vllm/vllm-openai:v0.26.0
          command: ["/bin/bash", "/scripts/prep.sh", "quantize"]   # smoke then default
          env:
            - { name: HF_HOME, value: /workspace/hf }
            - { name: HF_TOKEN, valueFrom: { secretKeyRef: { name: hf-token, key: HF_TOKEN } } }
            - { name: MUSE_MODEL, value: "meta-models/Muse-Glimmer-30B" }
            - { name: CALIB_DATASET, value: "NeelNanda/pile-10k" }
            - { name: ARTIFACTS, value: /workspace/artifacts }
          resources:
            limits: { nvidia.com/gpu: 1, cpu: "8", memory: 40Gi }
            requests: { cpu: "4", memory: 24Gi }
          volumeMounts:
            - { name: workspace, mountPath: /workspace }
            - { name: scripts, mountPath: /scripts }
      volumes:
        - { name: workspace, persistentVolumeClaim: { claimName: muse-quant-workspace } }
        - { name: scripts, configMap: { name: muse-quant-scripts, defaultMode: 0755 } }
---
# int4 W4A16 AutoRound quant (weight-only) — runs on ANY modern GPU (Ampere/Ada/Hopper/Blackwell +
# DGX Spark) via Marlin, unlike the Blackwell-only NVFP4 W4A4. Same pipeline, QUANT_SCHEME=W4A16.
# Should be LESS lossy than W4A4 (activations stay BF16). Queued to run after the eval freed the GPU.
apiVersion: batch/v1
kind: Job
metadata:
  name: muse-quant-w4a16-20260811
  namespace: default
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 28800
  template:
    spec:
      restartPolicy: Never
      runtimeClassName: nvidia
      enableServiceLinks: false
      priorityClassName: system-node-critical
      containers:
        - name: quantize
          image: vllm/vllm-openai:v0.26.0
          command: ["/bin/bash", "/scripts/prep.sh", "quantize"]   # smoke then default, scheme W4A16
          env:
            - { name: HF_HOME, value: /workspace/hf }
            - { name: HF_TOKEN, valueFrom: { secretKeyRef: { name: hf-token, key: HF_TOKEN } } }
            - { name: MUSE_MODEL, value: "meta-models/Muse-Glimmer-30B" }
            - { name: QUANT_SCHEME, value: "W4A16" }
            - { name: CALIB_DATASET, value: "NeelNanda/pile-10k" }
            - { name: ARTIFACTS, value: /workspace/artifacts }
          resources:
            limits: { nvidia.com/gpu: 1, cpu: "8", memory: 40Gi }
            requests: { cpu: "4", memory: 24Gi }
          volumeMounts:
            - { name: workspace, mountPath: /workspace }
            - { name: scripts, mountPath: /scripts }
      volumes:
        - { name: workspace, persistentVolumeClaim: { claimName: muse-quant-workspace } }
        - { name: scripts, configMap: { name: muse-quant-scripts, defaultMode: 0755 } }
---
# Selective-precision NVFP4 (mp1): keep mlp.down_proj ACTIVATIONS at 8-bit (the #1 W4A4 outlier
# module per the sensitivity plan in #81) while weights stay NVFP4 -> minimal size cost, aims to
# close the gap vs GPTQ. default-only (disk-safe, no smoke). Muse image is already on the node
# (no re-pull). Verify the export config_groups actually show a mixed scheme before trusting it.
apiVersion: batch/v1
kind: Job
metadata:
  name: muse-quant-nvfp4-mp1-20260811
  namespace: default
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 14400
  template:
    spec:
      restartPolicy: Never
      runtimeClassName: nvidia
      enableServiceLinks: false
      priorityClassName: system-node-critical
      containers:
        - name: quantize
          image: vllm/vllm-openai:muse-glimmer-x86_64-cu130
          command: ["/bin/bash", "/scripts/prep.sh", "quantize-default"]
          env:
            - { name: HF_HOME, value: /workspace/hf }
            - { name: HF_TOKEN, valueFrom: { secretKeyRef: { name: hf-token, key: HF_TOKEN } } }
            - { name: MUSE_MODEL, value: "meta-models/Muse-Glimmer-30B" }
            - { name: QUANT_SCHEME, value: "NVFP4" }
            - { name: RUN_TAG, value: "-mp1" }
            - { name: EXEMPT_MODULES, value: "down_proj" }
            - { name: EXEMPT_ACT_BITS, value: "8" }
            - { name: CALIB_DATASET, value: "NeelNanda/pile-10k" }
            - { name: ARTIFACTS, value: /workspace/artifacts }
          resources:
            limits: { nvidia.com/gpu: 1, cpu: "8", memory: 40Gi }
            requests: { cpu: "4", memory: 24Gi }
          volumeMounts:
            - { name: workspace, mountPath: /workspace }
            - { name: scripts, mountPath: /scripts }
      volumes:
        - { name: workspace, persistentVolumeClaim: { claimName: muse-quant-workspace } }
        - { name: scripts, configMap: { name: muse-quant-scripts, defaultMode: 0755 } }
