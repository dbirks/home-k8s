# DSpark: warm-start on the FULL overnight DeepSWE trajectory harvest (2026-07-25)
#
# The 2026-07-24/25 overnight DeepSWE run finished 2258/2260 -> 2204 local
# mini-swe-agent trajectories across 111 tasks (91 repos, 5 langs), generated by
# OUR vllm-qwen27 (hosted_vllm/main), in /output/deepswe-local/trajectories/.
# This is ~10-17x the data the 20260721 run used (111 diverse + capped-local).
#
# Data assembled in train.sh (/tmp/assemble.py): glob the harvest, CAP 10/task
# (balance; 111 tasks x 10 = ~1110 trajectories -> feasible extraction overnight
# while staying broadly diverse -> no overfit), key "conversations", roles
# system/user/assistant/tool ('exit' dropped). Plus the general anchor (if present)
# to hold general accept-len. prepare_data tokenizes from scratch, loss-masked to
# assistant turns; FAIL-FAST gate dies in the CPU phase before any GPU work.
#
# SPECULATORS: PINNED to fork dbirks/speculators @ c0f80db (carries the Qwen3.6
# RoPE / partial_rotary_factor fix, issue #613). We deliberately did NOT bump to
# upstream 60cd983 — verified the RoPE fix is NOT upstream, so a bump would
# reintroduce the 4x RoPE mismatch (~1.01 accept). We DO fold in ONE upstream
# best practice as a GUARDED patch: PR #848 (detach dspark backbone/markov outputs
# before the confidence head, so confidence-loss gradients don't corrupt the
# drafter) — applies only if the exact pre-#848 lines are present, else skips.
# (Full #848/#841/#860 adoption = rebase the fork's RoPE fix onto upstream + verify
# on a short run first — a follow-up, not this unattended run. See issue #59.)
#
# Warm-start from checkpoints-batch1k-v1/1 (accept_len 1.5316, known best).
# GPU: single card -- vllm-qwen27 scaled to replicas:0 in the SAME commit so this
# Job owns the whole GPU (matches the proven 0.75 extraction config).
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dspark-deepswe-full-script
  namespace: default
data:
  train.sh: |
    #!/bin/bash
    set -euo pipefail

    export HF_HOME=/data
    export CUDA_VISIBLE_DEVICES=0
    export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

    echo "=== [$(date)] DeepSWE-full training started ==="

    # Warm-start checkpoint must exist BEFORE the expensive phases (fail fast).
    if [ ! -f /output/checkpoints-batch1k-v1/1/config.json ]; then
        echo "FATAL: warm-start checkpoint /output/checkpoints-batch1k-v1/1 missing."; exit 1
    fi

    apt-get update -qq 2>&1 | tail -3
    apt-get install -y git --no-install-recommends -qq
    pip install uv --quiet --root-user-action ignore
    export PATH="/root/.local/bin:$PATH"
    hash -r
    export HF_HUB_ENABLE_HF_TRANSFER=1

    # PINNED fork commit (RoPE fix). Full clone + checkout so the SHA is exact.
    git clone https://github.com/dbirks/speculators /tmp/speculators-repo
    git -C /tmp/speculators-repo checkout c0f80dbada7567a9f7e978bc8b2e1c13906e4c7c
    echo "speculators @ $(git -C /tmp/speculators-repo rev-parse --short HEAD)"
    SPEC_SCRIPTS=/tmp/speculators-repo/scripts

    # --- SM120 source patches (same as the proven 20260721 run) ---
    python3 << 'PYPATCH'
    f = '/tmp/speculators-repo/src/speculators/utils/loading.py'
    c = open(f).read().replace('device="cpu"', 'device="cuda"')
    open(f, 'w').write(c)
    for f2 in [
        '/tmp/speculators-repo/src/speculators/models/dflash/core.py',
        '/tmp/speculators-repo/src/speculators/models/dspark/core.py',
    ]:
        c = open(f2).read().replace(
            'model.load_verifier_weights()',
            'model.to("cuda"); model.load_verifier_weights()'
        )
        open(f2, 'w').write(c)
    core_file = '/tmp/speculators-repo/src/speculators/models/dflash/core.py'
    c = open(core_file).read()
    OLD_BLOCK = (
        '        if config.transformer_layer_config._attn_implementation is None:  # noqa: SLF001\n'
        '            config.transformer_layer_config._attn_implementation = (  # noqa: SLF001\n'
        '                "simple_flex_attention"\n'
        '            )\n'
        '        self._attn_impl = config.transformer_layer_config._attn_implementation  # noqa: SLF001\n'
    )
    NEW_BLOCK = (
        '        config.transformer_layer_config._attn_implementation = "eager"  # noqa: SLF001\n'
        '        self._attn_impl = "eager"\n'
    )
    if OLD_BLOCK in c:
        open(core_file, 'w').write(c.replace(OLD_BLOCK, NEW_BLOCK))
    # --- GUARDED PR #848: detach before the confidence head (skips if not applicable) ---
    dspark_src = '/tmp/speculators-repo/src/speculators/models/dspark/core.py'
    c = open(dspark_src).read()
    p848 = 0
    OLD_A = 'conf_features = torch.cat([hidden_blocks, prev_emb.to(hidden_blocks.dtype)], dim=-1)'
    NEW_A = 'conf_features = torch.cat([hidden_blocks.detach(), prev_emb.detach().to(hidden_blocks.dtype)], dim=-1)'
    if OLD_A in c:
        c = c.replace(OLD_A, NEW_A); p848 += 1
    OLD_B = '        conf_features = hidden_blocks\n'
    NEW_B = '        conf_features = hidden_blocks.detach()\n'
    if OLD_B in c:
        c = c.replace(OLD_B, NEW_B); p848 += 1
    open(dspark_src, 'w').write(c)
    print(f"PR#848 confidence-detach patch: applied {p848}/2 sites (0 = fork already has it or code differs; safe either way)")
    PYPATCH
    uv pip install /tmp/speculators-repo hf_transfer --system --quiet
    uv pip install aiohttp datasets tqdm --system --quiet
    python3 << 'POSTINSTALL'
    dspark_inst = '/usr/local/lib/python3.12/dist-packages/speculators/models/dspark/core.py'
    c = open(dspark_inst).read()
    OLD = '        hidden, logits, targets, aligned_loss_mask, anchored_block_indices = (\n'
    NEW = '        max_anchors = min(max_anchors, 384)  # SM120 VRAM: 384*16=6144 Q, 1.87 GB attn\n        hidden, logits, targets, aligned_loss_mask, anchored_block_indices = (\n'
    if OLD in c:
        open(dspark_inst, 'w').write(c.replace(OLD, NEW, 1))
        import py_compile; py_compile.compile(dspark_inst)
    POSTINSTALL

    cat > /tmp/patch_flex_attention.py << 'PYFA'
    import os, glob
    th_file = '/usr/local/lib/python3.12/dist-packages/torch/_inductor/template_heuristics/triton.py'
    c = open(th_file).read()
    OLD_SM12X = (
        '            "sm12x": lambda h: (\n'
        '                FlexBwDConfig(32, 128, 128, 32, 3, 4)\n'
        '                if h < 64\n'
        '                else FlexBwDConfig(\n'
        '                    64, 64, 64, 64, 1 if h >= 128 else 2, 4\n'
        '                )\n'
        '            ),'
    )
    NEW_SM12X = (
        '            "sm12x": lambda h: (\n'
        '                FlexBwDConfig(32, 128, 128, 32, 3, 4)\n'
        '                if h < 64\n'
        '                else FlexBwDConfig(64, 16, 64, 16, 1, 4)\n'
        '            ),'
    )
    if OLD_SM12X in c:
        open(th_file, 'w').write(c.replace(OLD_SM12X, NEW_SM12X))
    for pyc in glob.glob(os.path.join(os.path.dirname(th_file), '__pycache__', 'triton.cpython*')):
        os.remove(pyc)
    PYFA
    python3 /tmp/patch_flex_attention.py

    ANCHOR=/output/swebench-traj-data/anchor.jsonl
    DATA_DIR=/output/deepswe-full-data
    PREP_DIR=/output/data-deepswe-full
    HS_DIR=$PREP_DIR/hidden-states
    CKPT_DIR=/output/checkpoints-deepswe-full-v1
    mkdir -p "$DATA_DIR" "$PREP_DIR" "$HS_DIR" "$CKPT_DIR" /output/logs

    # ----------------------------------------------------------------
    # Data assembly: the FULL overnight DeepSWE harvest, capped 10/task.
    # ----------------------------------------------------------------
    cat > /tmp/assemble.py << 'PYASM'
    import json, glob, os
    from collections import defaultdict
    STD = {"system", "user", "assistant", "tool"}
    def conv(t):
        cs = []
        for m in t.get("messages", []):
            if m.get("role") not in STD:
                continue
            c = m.get("content")
            if isinstance(c, list):
                c = "\n".join(p.get("text", "") for p in c if isinstance(p, dict))
            cs.append({"role": m["role"], "content": c or ""})
        return cs
    def has_asst(cs):
        return sum(1 for m in cs if m["role"] == "assistant") >= 1
    CAP = 10
    by = defaultdict(list)
    for fn in glob.glob("/output/deepswe-local/trajectories/*.traj.json"):
        by[os.path.basename(fn).rsplit(".", 3)[0]].append(fn)
    n = 0
    with open("/output/deepswe-full-data/deepswe-all.jsonl", "w") as f:
        for task, fns in by.items():
            for fn in sorted(fns)[:CAP]:
                try:
                    cs = conv(json.load(open(fn)))
                except Exception:
                    continue
                if has_asst(cs):
                    f.write(json.dumps({"conversations": cs}) + "\n"); n += 1
    print(f"assembled deepswe-all: {n} trajectories from {len(by)} tasks (cap {CAP}/task)")
    PYASM
    if [ ! -f "$DATA_DIR/deepswe-all.jsonl" ]; then python3 /tmp/assemble.py; fi
    echo "deepswe-all.jsonl lines: $(wc -l < "$DATA_DIR/deepswe-all.jsonl")"

    # ----------------------------------------------------------------
    # Prep (CPU-only, FAIL-FAST). Anchor included only if present.
    # ----------------------------------------------------------------
    if [ ! -f "$PREP_DIR/token_freq.pt" ]; then
        echo "=== [$(date)] Preparing DeepSWE-full data ==="
        PREP_ARGS="--data $DATA_DIR/deepswe-all.jsonl"
        if [ -f "$ANCHOR" ]; then PREP_ARGS="$PREP_ARGS --data $ANCHOR"; echo "including anchor"; else echo "WARN: anchor missing, proceeding without it"; fi
        python3 "$SPEC_SCRIPTS/prepare_data.py" \
            --model unsloth/Qwen3.6-27B-NVFP4 \
            $PREP_ARGS \
            --output "$PREP_DIR" \
            --seq-length 16384 \
            2>&1 | tee /output/logs/prepare_data_deepswe_full.log
        n_arrow=$(ls "$PREP_DIR"/*.arrow 2>/dev/null | wc -l)
        echo "[$(date)] Prep done -- $n_arrow arrow files"
        if [ "$n_arrow" -eq 0 ] || [ ! -f "$PREP_DIR/token_freq.pt" ]; then
            echo "FATAL: prep produced no arrow files / token_freq.pt. Aborting before GPU phase."
            echo "--- tail of prep log ---"; tail -40 /output/logs/prepare_data_deepswe_full.log
            exit 1
        fi
        prep_bytes=$(du -sb "$PREP_DIR" | cut -f1)
        echo "[$(date)] prepped dir size: $prep_bytes bytes"
        if [ "$prep_bytes" -lt 1000000 ]; then
            echo "FATAL: prepped data suspiciously small ($prep_bytes bytes). Aborting."; exit 1
        fi
    else
        echo "[$(date)] Skipping prep -- token_freq.pt exists"
    fi

    # ----------------------------------------------------------------
    # Phase 1: hidden-state extraction (vLLM on the GPU).
    # ----------------------------------------------------------------
    if [ ! -f "$PREP_DIR/phase1_complete" ]; then
        echo "=== [$(date)] Phase 1: hidden states ==="
        unset PYTORCH_CUDA_ALLOC_CONF
        python3 "$SPEC_SCRIPTS/launch_vllm.py" unsloth/Qwen3.6-27B-NVFP4 \
            --target-layer-ids 1 16 31 46 61 \
            --hidden-states-path "$HS_DIR" \
            -- \
            --gpu-memory-utilization 0.75 --port 8001 \
            --max-model-len 20480 --dtype bfloat16 --trust-remote-code \
            --served-model-name main \
            --kv-cache-dtype fp8_e4m3 \
            --mamba-cache-dtype float16 --mamba-ssm-cache-dtype float16 \
            --enforce-eager --max-num-seqs 4 \
            > /output/logs/vllm_phase1_deepswe_full.log 2>&1 &
        VLLM_PID=$!
        trap "kill $VLLM_PID 2>/dev/null; wait $VLLM_PID 2>/dev/null" EXIT
        for i in $(seq 1 540); do
            curl -sf http://localhost:8001/health >/dev/null 2>&1 && break
            if ! kill -0 $VLLM_PID 2>/dev/null; then
                echo "ERROR: vLLM died in Phase 1. Full log:"; cat /output/logs/vllm_phase1_deepswe_full.log; exit 1
            fi
            sleep 10
        done
        echo "[$(date)] vLLM healthy for Phase 1"
        find "$HS_DIR" -name "*.lock" -delete 2>/dev/null || true
        find "$HS_DIR" -name "cmpl-*.safetensors" -delete 2>/dev/null || true
        find "$HS_DIR" -name "*.incomplete" -delete 2>/dev/null || true

        # 2026-07-25: --concurrency 1 (was 4). The hidden-states connector coordinates
        # workers with a NON-BLOCKING exclusive flock; on the slow HDD PVC with the
        # larger (1110-traj) dataset, 4 workers contend -> fcntl.flock LOCK_NB fails
        # (BlockingIOError [Errno 11]) -> 10 consecutive errors -> abort. Single worker
        # = zero inter-worker lock contention. Extraction is GPU-fast (~packed seqs),
        # so the serialization cost is small; reliability wins for an unattended run.
        python3 "$SPEC_SCRIPTS/data_generation_offline.py" \
            --endpoint http://localhost:8001/v1 \
            --preprocessed-data "$PREP_DIR" \
            --output "$HS_DIR" \
            --concurrency 1 --max-consecutive-errors 10 \
            2>&1 | tee /output/logs/data_gen_deepswe_full.log

        kill $VLLM_PID 2>/dev/null; wait $VLLM_PID 2>/dev/null || true
        trap - EXIT
        touch "$PREP_DIR/phase1_complete"
        echo "[$(date)] Phase 1 complete -- $(find "$HS_DIR" -maxdepth 1 -name 'hs_*.safetensors' | wc -l) hidden states"
    else
        echo "[$(date)] Skipping Phase 1 -- sentinel exists"
    fi

    # ----------------------------------------------------------------
    # Phase 2: warm-start from checkpoints-batch1k-v1/1 (accept_len 1.5316).
    # ----------------------------------------------------------------
    export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
    echo "=== [$(date)] Phase 2: warm-start training on the full DeepSWE harvest ==="

    python3 "$SPEC_SCRIPTS/train.py" \
        --verifier-name-or-path unsloth/Qwen3.6-27B-NVFP4 \
        --speculator-type dspark \
        --from-pretrained /output/checkpoints-batch1k-v1/1 \
        --max-anchors 384 \
        --target-layer-ids 1 16 31 46 61 \
        --loss-fn '{"ce": 0.1, "tv": 0.9}' \
        --confidence-head-alpha 1.0 \
        --total-seq-len 2048 \
        --epochs 1 \
        --lr 3e-4 \
        --on-missing skip \
        --data-path "$PREP_DIR" \
        --hidden-states-path "$HS_DIR" \
        --save-path "$CKPT_DIR" \
        --checkpoint-freq 0.25 \
        --num-workers 2 --prefetch-factor 1 \
        2>&1 | tee /output/logs/trainer_deepswe_full.log

    echo "=== [$(date)] DeepSWE-full training complete ==="
    ls -lh "$CKPT_DIR"/

    echo "[$(date)] Reclaiming hidden-state disk ($(du -sh "$HS_DIR" | cut -f1))..."
    rm -rf "$HS_DIR"
    echo "[$(date)] Done."
---
apiVersion: batch/v1
kind: Job
metadata:
  name: dspark-train-deepswe-full-20260725
  namespace: default
spec:
  backoffLimit: 200
  activeDeadlineSeconds: 86400
  template:
    spec:
      restartPolicy: OnFailure
      runtimeClassName: nvidia
      enableServiceLinks: false
      priorityClassName: system-node-critical
      tolerations:
        - key: node.kubernetes.io/disk-pressure
          operator: Exists
          effect: NoSchedule
      initContainers:
        - name: gpu-clock-lock
          image: nvcr.io/nvidia/cuda:13.0.1-base-ubi9
          imagePullPolicy: IfNotPresent
          securityContext:
            privileged: true
          env:
            - name: NVIDIA_VISIBLE_DEVICES
              value: all
            - name: NVIDIA_DRIVER_CAPABILITIES
              value: utility
          command:
            - sh
            - -c
            - |
              nvidia-smi -pm 1
              nvidia-smi -pl 400
      containers:
        - name: trainer
          image: vllm/vllm-openai:v0.24.0
          imagePullPolicy: IfNotPresent
          command: ["/bin/bash", "/scripts/train.sh"]
          env:
            - name: HF_HOME
              value: /data
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: hf-token
                  key: HF_TOKEN
            - name: PYTORCH_CUDA_ALLOC_CONF
              value: expandable_segments:True
          resources:
            limits:
              nvidia.com/gpu: 1
              cpu: "4"
              memory: 24Gi
            requests:
              cpu: "4"
              memory: 24Gi
          volumeMounts:
            - name: models
              mountPath: /data
            - name: output
              mountPath: /output
            - name: scripts
              mountPath: /scripts
            - name: shm
              mountPath: /dev/shm
      volumes:
        - name: models
          persistentVolumeClaim:
            claimName: vllm-models
        - name: output
          persistentVolumeClaim:
            claimName: dspark-output-hdd-v2
        - name: scripts
          configMap:
            name: dspark-deepswe-full-script
            defaultMode: 0755
        - name: shm
          emptyDir:
            medium: Memory
            sizeLimit: 16Gi
