# Node swap via a swap FILE on the NVMe (fast — HDD swap thrashed the node to a hang under a big ML spill).
# Both disks are full XFS (no room for a Talos SwapVolumeConfig partition, XFS can't shrink), so a file it is.
# Freed ~210GB on the NVMe (deleted laguna-models-nvme PVC) so an 80GB swapfile stays well above DiskPressure.
# Kubelet already patched failSwapOn:false + memorySwap:LimitedSwap. This privileged DaemonSet disables any
# old swap, creates an 80GB swapfile on the NVMe EPHEMERAL (/var/lib) and swapon's it. Re-runs on reboot.
# Also removes the orphaned HDD swapfile from the earlier attempt. Lets Burstable pods spill instead of OOM.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-swapfile
  namespace: default
spec:
  selector:
    matchLabels: { app: node-swapfile }
  template:
    metadata:
      labels: { app: node-swapfile }
    spec:
      hostPID: true
      tolerations:
        - operator: Exists
      containers:
        - name: swapfile
          image: debian:bookworm-slim
          securityContext:
            privileged: true
            seccompProfile: { type: Unconfined }
          env:
            - { name: SWAP_DIR, value: "/hostnvme/_swap" }   # on the NVMe EPHEMERAL (/var/lib)
            - { name: SIZE_GB, value: "80" }
          command: ["/bin/bash","-c"]
          args:
            - |
              set -uo pipefail
              # 1) disable any existing swap (idle HDD swap from the earlier attempt) + remove the orphaned HDD file
              swapoff -a 2>/dev/null || true
              rm -f /hosthdd/_swap/swapfile 2>/dev/null || true; rmdir /hosthdd/_swap 2>/dev/null || true
              # 2) create + enable the NVMe swapfile
              SF="$SWAP_DIR/swapfile"
              SZ_MIB=$((SIZE_GB*1024))
              mkdir -p "$SWAP_DIR"
              cur_mib=$(( $(stat -c%s "$SF" 2>/dev/null || echo 0) / 1048576 ))
              if [ "$cur_mib" -lt "$SZ_MIB" ]; then
                echo "[$(date)] creating ${SIZE_GB}GiB swapfile at $SF on NVMe (dd oflag=direct, no page cache)"
                swapoff "$SF" 2>/dev/null || true; rm -f "$SF"
                dd if=/dev/zero of="$SF" bs=1M count="$SZ_MIB" oflag=direct status=progress
                chmod 600 "$SF"; mkswap "$SF"
              else
                echo "[$(date)] swapfile already ${cur_mib}MiB >= ${SZ_MIB}MiB"
              fi
              swapon "$SF" 2>&1 || echo "(swapon note: likely already active)"
              echo "=== /proc/swaps ==="; cat /proc/swaps
              echo "=== SwapTotal/MemTotal ==="; grep -iE "SwapTotal|MemTotal" /proc/meminfo
              echo "[$(date)] NVMe swap active; holding (re-runs on reboot)"
              sleep infinity
          resources:
            requests: { cpu: "50m", memory: 64Mi }
            limits: { cpu: "1" }   # no memory limit — dd write must not be cgroup-OOM'd
          volumeMounts:
            - { name: nvme, mountPath: /hostnvme }
            - { name: hdd, mountPath: /hosthdd }
      volumes:
        - name: nvme
          hostPath: { path: /var/lib, type: Directory }          # NVMe EPHEMERAL
        - name: hdd
          hostPath: { path: /var/mnt/hdd-storage, type: Directory }   # HDD (to clean the orphaned swapfile)
