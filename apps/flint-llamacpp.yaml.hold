# flint — Recursive Flint NVFP4 GGUF on llama.cpp (llama-server, CUDA, SM120). Issue #158. PARKED at replicas: 0.
# ============================================================================================
# Why llama.cpp first, not vLLM: the GGUF card lists RTX PRO 6000 Blackwell among the tested GPUs for
# llama.cpp. vLLM's day-0 Flint kernels (PR #62938) are FlashInfer/CuTe DSL SM100 (tcgen05) kernels,
# validated only on GB200, and the recipe says they are "always used" on one GPU. SM120 has no tcgen05,
# so vLLM is the second try (apps/flint-vllm.yaml.hold).
#
# Image: ghcr.io/dbirks/llama-cpp-flint, built by .github/workflows/build-llama-flint.yaml from llama.cpp
# master b11799 (has #30861 MoE scaling + #30929 jinja hex escapes) + Flint PR #30928 (1b44e307, still OPEN),
# CUDA 12.8, arch 120a-real. Pin the digest from the workflow run before going live.
#
# SWITCH (wait for David): ninfer replicas 0 (apps/ninfer-standalone.yaml) and this one to 1 in the SAME
# commit, then swap the Collective backend (commented `flint` block in apps/llm-collective-contributor.yaml).
# Rollback is the reverse; the NInfer v3 PVC and image stay untouched.
#
# SPLIT KV (2026-10-21, after the first hour of real agent traffic): with --kv-unified there is ONE KV stream
#   and llama.cpp attends over every cell up to the highest one in use (llama_kv_cache::get_n_kv ->
#   used_max_p1), so each decode step scanned the whole ~1.3M-cell pool that 16 cached agent sessions
#   filled: ~58 ms/token at 5 busy slots (5 ms single), ~17 tok/s per request, ~0.2 tok/s while a long prompt
#   prefilled. --no-kv-unified gives each slot its own stream, so a step costs the longest ACTIVE context,
#   not the sum of everything cached. Price: a fixed per-slot context (ctx-size / parallel).
# SIZING (measured: 47.3 GB = 44.1 GiB in a 50000 slice with an 18.6 GiB pool, so ~25.5 GiB is weights +
#   compute + SWA): 55000 MB slice (53.7 GiB, NInfer's old size; 25000 CLEF + 2x 8000 TTS + 55000 = 96000 of
#   97887) leaves ~28 GiB for KV. q8_0 = ~14.9 KiB/token on the 14 full-attention layers:
#   8 x 229,376 = 1,835,008 tokens = ~26.1 GiB. Agent prompts of 171-174K were seen, so 8 x 224K beats 16 x 112K.
#   KV TYPE: llama.cpp has no FP8 KV type; q8_0 is the near-lossless one (card uses f16, A/B it).
# HOST RAM: --load-mode none (no mmap) + --cache-ram 0 so the 23 GB file does not sit in page cache or a host prompt
#   cache; the node has 46 GB, no swap.
# ZDR (#98): no --slot-save-path (no on-disk KV), no verbose/prompt logging, --cache-ram 0 (no host prompt cache).
# ============================================================================================
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: flint
  namespace: default
  labels:
    app.kubernetes.io/name: flint
spec:
  replicas: 1                     # PARKED (.hold) 2026-10-22: replaced by apps/flint-vllm.yaml. To revive: rename this to .yaml and that one to .hold.
  # NO SURGE: two 50 GB slices cannot fit beside CLEF + 2x TTS.
  strategy:
    type: RollingUpdate
    rollingUpdate: { maxSurge: 0, maxUnavailable: 1 }
  selector:
    matchLabels:
      app.kubernetes.io/name: flint
  template:
    metadata:
      labels:
        app.kubernetes.io/name: flint
    spec:
      runtimeClassName: nvidia
      enableServiceLinks: false
      nodeSelector: { kubernetes.io/hostname: talos-210-73x }   # the PRO 6000 + the HDD PVC
      containers:
        - name: main
          image: ghcr.io/dbirks/llama-cpp-flint:b11799-pr30928-1b44e307@sha256:ffcb4edcb923b45a055a374b0090df040033611b987175b49ef8b2364a6598b2   # workflow run 39673515873
          command: ["/app/llama-server"]
          args:
            - "--model"
            - "/models/flint-nvfp4-gguf/flint-nvfp4.gguf"
            - "--alias"
            - "flint"
            - "--host"
            - "0.0.0.0"
            - "--port"
            - "8080"
            - "--gpu-layers"
            - "all"
            - "--flash-attn"
            - "on"
            - "--cache-type-k"
            - "q8_0"                      # card uses f16; q8_0 halves KV (see KV TYPE above)
            - "--cache-type-v"
            - "q8_0"
            - "--ctx-size"
            - "1835008"                   # 8 slots x 229,376 tokens, each slot its own KV stream (see SPLIT KV)
            - "--parallel"
            - "8"
            - "--no-kv-unified"
            - "--jinja"                   # chat template from the GGUF (needs #30929 hex escapes)
            - "--reasoning-format"
            - "deepseek"                  # think block -> reasoning_content (preserve it across turns)
            - "--temperature"
            - "1.0"
            - "--top-p"
            - "0.95"
            - "--top-k"
            - "20"
            - "--min-p"
            - "0"
            - "--n-predict"
            - "65536"                     # default output budget incl. reasoning (the card's client configs)
            - "--load-mode"
            - "none"                      # no mmap (b11799 replaced --no-mmap with --load-mode)
            - "--cache-ram"
            - "0"
            - "--metrics"
            - "--no-webui"
          # Leave --swa-full unset: compact sliding-window KV (model card).
          env:
            - { name: NVIDIA_VISIBLE_DEVICES, value: "all" }
            - { name: NVIDIA_DRIVER_CAPABILITIES, value: "compute,utility" }
          ports:
            - containerPort: 8080
          startupProbe:                   # 23 GB off the HDD + upload: allow 15 min
            httpGet: { path: /health, port: 8080 }
            periodSeconds: 10
            failureThreshold: 90
          livenessProbe:
            httpGet: { path: /health, port: 8080 }
            periodSeconds: 20
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            httpGet: { path: /health, port: 8080 }
            periodSeconds: 10
            timeoutSeconds: 5
          resources:
            limits: { nvidia.com/gpu: "1", nvidia.com/gpumem: "55000", cpu: "8", memory: 16Gi }
            requests: { cpu: "2", memory: 4Gi }
          volumeMounts:
            - { name: models, mountPath: /models, readOnly: true }
      volumes:
        - name: models
          persistentVolumeClaim:
            claimName: flint-models-hdd
            readOnly: true
---
apiVersion: v1
kind: Service
metadata:
  name: flint
  namespace: default
  labels:
    app.kubernetes.io/name: flint
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: flint
  ports:
    - name: http
      port: 8080
      targetPort: 8080
