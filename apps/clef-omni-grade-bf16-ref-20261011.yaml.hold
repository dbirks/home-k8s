# Same-path BF16 reference for the parity metric (issue #152): grade the BF16 release through serve_clef.py
# (grouped experts, exactly how every export is graded), then rescore all saved export rows against it with
# reparity.py. Fixes the eager-vs-grouped reference artifact. GPU ~15 min; Pennyroyal at 0.
---
apiVersion: batch/v1
kind: Job
metadata:
  name: clef-omni-grade-bf16-ref
  namespace: default
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 7200
  ttlSecondsAfterFinished: 604800
  template:
    metadata:
      labels: { app: clef-omni-grade-bf16-ref }
    spec:
      restartPolicy: Never
      enableServiceLinks: false
      runtimeClassName: nvidia
      containers:
        - name: grade
          image: python:3.12-slim
          command: ["/bin/bash", "-lc"]
          args:
            - |
              set -uo pipefail
              export HF_HOME=/work/.hf-home HF_HUB_OFFLINE=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
              PY=/work/venv/bin/python
              "$PY" /scripts/eval_export.py --export /work/clef-omni --out /work/bf16/results/export 2>&1 | tee /work/logs/grade-bf16-ref.log | grep -E 'EXPORT PARITY|Traceback|Error' | grep -v Warning
              [ "${PIPESTATUS[0]}" -eq 0 ] || exit 1
              args=""
              for e in int4=/work/int4/results/fast nvfp4a16=/work/nvfp4a16/results/export nvfp4=/work/nvfp4-experts/results/export-default \
                       nvfp4-actsim=/work/nvfp4-experts/results/export-sim fp8=/work/fp8/results/export fp8-actsim=/work/fp8/results/export-actsim \
                       nvfp4a16-ar=/work/nvfp4a16-ar/results nvfp4-ar=/work/nvfp4-ar/results; do
                f=${e#*=}/parity_export_rows.jsonl; [ -f "$f" ] && args="$args ${e%%=*}=$f"
              done
              "$PY" /scripts/reparity.py --reference /work/bf16/results/export/parity_export_rows.jsonl \
                --out /work/bf16/results/reparity.json $args
          resources:
            requests: { cpu: "2", memory: 12Gi }
            limits:   { cpu: "8", memory: 34Gi, nvidia.com/gpu: 1, nvidia.com/gpumem: 97000 }
          volumeMounts:
            - { name: work, mountPath: /work }
            - { name: scripts, mountPath: /scripts, readOnly: true }
      volumes:
        - { name: work, persistentVolumeClaim: { claimName: clef-omni-hdd } }
        - { name: scripts, configMap: { name: clef-omni-scripts } }
