# On-policy data generation for a Qwen3.8-27B draft model (DFlash/DSpark drafter).
# PARKED (.hold) — activate when the thinking-mode eval frees the GPU. Keeps the GPU busy overnight.
#
# Recipe (proven for the Qwen3.6 DSpark drafter, see the corpus game-plan): single-turn, ON-POLICY,
# reasoning-ON regeneration. We serve OUR NVFP4 Qwen3.8 quant as the target (fast on SM120 FP4 cores,
# near-lossless per the eval, and the exact model people deploy — so this data is on-policy for the
# quant, not just BF16), then regenerate diverse prompts through it with full thinking traces.
# Output -> dspark-dataset-hdd:/dataset/qwen38-onpolicy-v1 (resumable via --resume).
#
# No spec-decode during gen for now (MTP on this hybrid arch may need vLLM >=0.27.2; keep it simple
# and validate MTP separately). NVFP4 W4A4 on the 96GB card is fast enough at concurrency 32.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: qwen38-regen-20260815-script
  namespace: default
data:
  run.sh: |
    #!/bin/bash
    set -euo pipefail
    export HF_HOME=/data HF_HUB_ENABLE_HF_TRANSFER=1 TOKENIZERS_PARALLELISM=false
    (apt-get update -qq && apt-get install -y git --no-install-recommends -qq) 2>&1 | tail -1
    pip install uv --quiet --root-user-action ignore
    export PATH="/root/.local/bin:$PATH"; hash -r
    git clone https://github.com/dbirks/speculators /tmp/spec
    git -C /tmp/spec checkout 188a7b37919211749404d420271f3fdbc14924a6
    SCRIPTS=/tmp/spec/scripts
    uv pip install /tmp/spec aiohttp datasets tqdm --system --quiet

    # serve OUR local NVFP4 Qwen3.8 quant (already on the qwen38 PVC; no download)
    MODEL=/workspace/runs/Qwen3.6-27B-NVFP4-c1-screen/Qwen3.8-27B-nvfp-w4g16
    DS=/dataset/qwen38-onpolicy-v1
    mkdir -p "$DS" /output/logs

    echo "=== [$(date)] serve Qwen3.8-27B NVFP4 (target for on-policy regen) ==="
    # HAMi co-residence: capped at nvidia.com/gpumem 48000 (serving model holds 44GB of the 96GB card),
    # so --gpu-memory-utilization 0.88 is 0.88 of 48GB. Concurrency/batched-tokens trimmed from the
    # full-card tuning (was 32 / 32768) to fit the slice; still plenty for overnight throughput.
    vllm serve "$MODEL" --served-model-name main "$MODEL" --host 0.0.0.0 --port 8001 \
        --gpu-memory-utilization 0.88 --max-model-len 12288 --dtype auto \
        --trust-remote-code --kv-cache-dtype fp8_e4m3 --max-num-seqs 24 \
        --max-num-batched-tokens 16384 --no-enable-prefix-caching \
        > /output/logs/qwen38_regen_vllm.log 2>&1 &
    VP=$!; trap 'kill $VP 2>/dev/null; wait $VP 2>/dev/null' EXIT
    for i in $(seq 1 300); do
        curl -sf http://127.0.0.1:8001/health >/dev/null 2>&1 && { echo "[$(date)] healthy after $((i*10))s"; break; }
        kill -0 $VP 2>/dev/null || { echo "vLLM died:"; tail -60 /output/logs/qwen38_regen_vllm.log; exit 1; }
        [ "$i" -eq 300 ] && { echo "serve timeout"; tail -40 /output/logs/qwen38_regen_vllm.log; exit 1; }
        sleep 10
    done
    echo "[$(date)] serve healthy — starting on-policy regen (reasoning-ON, 8192-token traces)"

    # coding-weighted diverse start (matches the proven recipe); staged toward ~50k+. --resume-safe.
    for spec in opc-python:25000 typescript-instruct:25000; do
        ds=${spec%%:*}; lim=${spec##*:}
        echo "=== [$(date)] regen $ds (limit $lim) ==="
        python3 "$SCRIPTS/response_regeneration/script.py" \
            --dataset "$ds" --limit "$lim" \
            --endpoint http://127.0.0.1:8001/v1/chat/completions --model "$MODEL" \
            --max-tokens 8192 --concurrency 32 \
            --outfile "$DS/regen_${ds}.jsonl" --resume 2>&1 | tail -20
    done
    kill $VP 2>/dev/null; wait $VP 2>/dev/null || true; trap - EXIT
    cat "$DS"/regen_*.jsonl > "$DS/all.jsonl" 2>/dev/null || true
    echo "[$(date)] qwen3.8 on-policy corpus rows: $(wc -l < "$DS/all.jsonl" 2>/dev/null || echo 0)"
    touch "$DS/regen.done"
    echo "=== [$(date)] Qwen3.8 on-policy regen complete ==="
---
apiVersion: batch/v1
kind: Job
metadata:
  name: qwen38-regen-v2-20260815
  namespace: default
spec:
  backoffLimit: 4
  activeDeadlineSeconds: 86400
  template:
    metadata:
      labels: { app: qwen38-regen }
    spec:
      restartPolicy: OnFailure
      runtimeClassName: nvidia
      enableServiceLinks: false
      containers:
        - name: regen
          image: vllm/vllm-openai:muse-glimmer-x86_64-cu130
          command: ["/bin/bash", "/scripts/run.sh"]
          env:
            - { name: HF_HOME, value: /data }
            - { name: HF_TOKEN, valueFrom: { secretKeyRef: { name: hf-token, key: HF_TOKEN } } }
            - { name: FLASHINFER_CUDA_ARCH_LIST, value: "12.0f" }
            - { name: VLLM_NVFP4_GEMM_BACKEND, value: "flashinfer-cutlass" }
            # NOTE: expandable_segments removed — it uses the CUDA VMM API (cuMemCreate) that HAMi-core
            # intercepts; the default allocator is proven working under HAMi (the serving pod uses it).
          resources:
            # HAMi hard cap so it co-resides with the 44GB serving model (44+48=92 < 96GB physical).
            # Host memory limited (no swap on the node) to avoid a host OOM under RAM pressure.
            limits: { nvidia.com/gpu: 1, nvidia.com/gpumem: "48000", memory: 28Gi }
            requests: { cpu: "4", memory: 12Gi }
          volumeMounts:
            - { name: workspace, mountPath: /workspace }
            - { name: models, mountPath: /data }
            - { name: dataset, mountPath: /dataset }
            - { name: output, mountPath: /output }
            - { name: scripts, mountPath: /scripts }
            - { name: shm, mountPath: /dev/shm }
      volumes:
        - { name: workspace, persistentVolumeClaim: { claimName: qwen38-quant-workspace } }
        - { name: models, persistentVolumeClaim: { claimName: vllm-models } }
        - { name: dataset, persistentVolumeClaim: { claimName: dspark-dataset-hdd } }
        - { name: output, persistentVolumeClaim: { claimName: dspark-output-hdd-v2 } }
        - { name: scripts, configMap: { name: qwen38-regen-20260815-script, defaultMode: 0755 } }
        - { name: shm, emptyDir: { medium: Memory, sizeLimit: 8Gi } }   # memory-backed -> counts vs host RAM
