# W4A16 (int4 weight-only) AutoRound quant of granite-4.2-30b — 4-bit int weights, BF16 activations,
# Marlin-servable on any modern GPU, less lossy than W4A4. default = FULL-quality (CORESIDENT_LITE=0).
#
# PARKED .hold. Un-hold ONLY AFTER the NVFP4 job COMPLETES (serialize GPU + host RAM — never both at once)
# and while qwen3.8-27b is still scaled to 0. Rename to .yaml + commit. Output ->
# /data/runs/granite-4.2-30b-W4A16-AutoRound-default on the granite-models PVC.
apiVersion: batch/v1
kind: Job
metadata:
  name: granite42-quant-w4a16-20260826
  namespace: default
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 21600
  ttlSecondsAfterFinished: 259200
  template:
    spec:
      restartPolicy: Never
      runtimeClassName: nvidia
      enableServiceLinks: false
      # NO system-node-critical: that priority stops the kubelet/OOM-killer from shedding this pod
      # under memory pressure, which wedged the whole node (2026-08-26). Let it be evictable instead.
      containers:
        - name: quantize
          image: vllm/vllm-openai:muse-glimmer-x86_64-cu130
          command: ["/bin/bash", "/scripts/prep.sh", "quantize"]
          env:
            - { name: GRANITE_MODEL, value: "/data/granite-4.2-30b" }
            - { name: QUANT_SCHEME, value: "W4A16" }
            - { name: CALIB_DATASET, value: "NeelNanda/pile-10k" }
            - { name: CORESIDENT_LITE, value: "0" }   # FULL best-quality calib (qwen scaled to 0 first)
          resources:
            limits: { nvidia.com/gpu: 1, cpu: "8", memory: 30Gi, nvidia.com/gpumem: 60000 }
            requests: { cpu: "4", memory: 12Gi }
          volumeMounts:
            - { name: models, mountPath: /data }
            - { name: scripts, mountPath: /scripts }
      volumes:
        - { name: models, persistentVolumeClaim: { claimName: granite-models } }
        - { name: scripts, configMap: { name: granite-quant-scripts, defaultMode: 0755 } }
