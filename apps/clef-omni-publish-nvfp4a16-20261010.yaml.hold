# Publish the NVFP4A16 export as PRIVATE dbirks/clef-omni-nvfp4a16, tag v0.1 (issue #152), via
# scripts/clef-omni/hf_publish.py (card + serve_clef.py into the export, SHA256SUMS rewritten,
# resumable upload, annotated tag carrying the quants.json version note). CPU-only.
# Retire to .yaml.hold once verified.
---
apiVersion: batch/v1
kind: Job
metadata:
  name: clef-omni-publish-nvfp4a16-v0.1
  namespace: default
spec:
  backoffLimit: 3
  activeDeadlineSeconds: 43200
  ttlSecondsAfterFinished: 604800
  template:
    metadata:
      labels: { app: clef-omni-publish }
    spec:
      restartPolicy: Never
      enableServiceLinks: false
      containers:
        - name: publish
          image: python:3.12-slim
          command: ["/bin/bash", "-lc"]
          args:
            - |
              set -euo pipefail
              export HF_HOME=/work/.hf-home HF_HUB_DISABLE_TELEMETRY=1
              /work/venv/bin/python /scripts/hf_publish.py --repo dbirks/clef-omni-nvfp4a16 \
                --export /work/nvfp4a16/export --card /scripts/card_clef-omni-nvfp4a16.md --private --tag v0.1
          env:
            - name: HF_TOKEN
              valueFrom: { secretKeyRef: { name: hf-write-token, key: HF_TOKEN } }
          resources:
            requests: { cpu: "1", memory: 2Gi }
            limits:   { cpu: "4", memory: 6Gi }
          volumeMounts:
            - { name: work, mountPath: /work }
            - { name: scripts, mountPath: /scripts, readOnly: true }
      volumes:
        - { name: work, persistentVolumeClaim: { claimName: clef-omni-hdd } }
        - { name: scripts, configMap: { name: clef-omni-scripts } }
