# ============================ PARKED (.yaml.hold) ============================
# Flux ignores this. Parked 2026-08-11 to take the endpoint DOWN for the whole
# Muse-Glimmer NVFP4 quantization (apps/muse-quant.yaml) — the quant owns the GPU.
# A stuck helm upgrade was flapping qwen27; pruning the HelmRelease (via .hold)
# uninstalls it cleanly and frees the card. To serve again: rename -> .yaml, set
# qwen27 replicaCount back to 1, reconcile. (muse-glimmer stays at 0 as before.)
# ============================================================================
# vLLM Production Stack — the /v1 backend for llm.birks.dev.
#
# Serves Qwen3.6-27B-NVFP4 behind the stack's OpenAI-compatible router. kgateway's
# /v1 HTTPRoute points at the router Service (see apps/llm-routes.yaml). Plan/rationale
# in GitHub #66. On ONE 96GB GPU only one model runs at a time — this file serves Qwen
# only; the Laguna swap-mode config is preserved in #66 + git history if ever wanted.
#
# SM120 notes: v0.26.0 + VLLM_ATTENTION_BACKEND=FLASHINFER (0.26 crashes cutedsl on
# SM120 without it). Qwen3.6 is a hybrid DeltaNet+Attention model -> fp8 KV is OK but
# the DeltaNet recurrent state must be float16 (--mamba-cache-dtype), and prefix caching
# is off (hybrid GDN bug). Spec-decode (DFlash/DSpark drafter) intentionally OMITTED for
# the first bringup — add --speculative-config once the plain serve is confirmed healthy.
#
# GPU: requires plain apps/vllm.yaml (vllm-qwen27) scaled to 0 first — two Qwens can't
# co-reside. Router is ClusterIP (reached in-cluster by kgateway; no MetalLB IP).
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: vllm-production-stack
  namespace: flux-system
spec:
  interval: 1h
  url: https://vllm-project.github.io/production-stack
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: vllm-stack
  namespace: default
spec:
  interval: 10m
  timeout: 45m   # first engine init + model download/load is slow
  chart:
    spec:
      chart: vllm-stack
      version: "0.1.12"
      sourceRef:
        kind: HelmRepository
        name: vllm-production-stack
        namespace: flux-system
      interval: 1h
  values:
    servingEngineSpec:
      enableEngine: true
      runtimeClassName: "nvidia"
      strategy:
        type: Recreate   # never overlap engine pods on the shared GPU (avoids double-alloc OOM)
      serviceMonitor:
        enabled: false   # no Prometheus-operator ServiceMonitor CRD on this cluster; vLLM still exposes /metrics
      modelSpec:
        - name: qwen27
          enabled: true
          replicaCount: 0   # SCALED DOWN: GPU handed to the Muse-Glimmer NVFP4 AutoRound
                            # quantization Job (apps/muse-quant.yaml). Restore to 1 to serve.
          repository: "vllm/vllm-openai"
          tag: "v0.26.0"
          modelURL: "unsloth/Qwen3.6-27B-NVFP4"
          runtimeClassName: "nvidia"
          requestGPU: 1
          requestCPU: 4
          requestMemory: "24Gi"
          pvcStorage: "60Gi"
          storageClass: "local-path"
          shmSize: "16Gi"
          enableLoRA: false          # FOOTGUN: chart defaults true -> injects --enable-lora + sidecar
          hf_token:
            secretName: "hf-token"
            secretKey: "HF_TOKEN"
          keda:
            enabled: false           # manual, no autoscaling
          vllmConfig:
            # omit `v0` -> V1 engine (v0:"1" forces legacy V0)
            enablePrefixCaching: false
            maxModelLen: 16384
            gpuMemoryUtilization: 0.88
            extraArgs:
              # --enforce-eager: skip inductor CUDA-graph compilation. On SM120 that
              # compilation for 27B overruns the chart's 10-min startup probe -> the
              # engine got SIGKILLed at 10min and crash-looped. Eager loads in ~3-5min
              # and passes the probe. Costs some decode latency (no CUDA graphs); revisit
              # once stable (extend startupProbe.failureThreshold instead to keep graphs).
              - "--enforce-eager"
              - "--kv-cache-dtype"
              - "fp8_e4m3"
              - "--mamba-cache-dtype"
              - "float16"
              - "--mamba-ssm-cache-dtype"
              - "float16"
              - "--trust-remote-code"
              - "--served-model-name"
              - "main"
              - "qwen27"
          env:
            # Override the service-link env the `vllm` Service injects as
            # VLLM_PORT=tcp://...:80 (which vLLM misreads as its port -> crash). The
            # chart can't set enableServiceLinks:false, but an explicit container env
            # var wins over kubelet's injected one. 8000 is vLLM's default API port.
            - name: VLLM_PORT
              value: "8000"
            - name: VLLM_ATTENTION_BACKEND
              value: "FLASHINFER"       # SM120: required on v0.26.0
            - name: VLLM_USE_FLASHINFER_MOE_MXFP4_MXFP8
              value: "1"
            - name: VLLM_FLASHINFER_MOE_BACKEND
              value: "latency"
            - name: FLASHINFER_CUDA_ARCH_LIST
              value: "12.0f"
        # muse-glimmer: a SECOND model kept at replicaCount: 0 ON PURPOSE — present in
        # git and ready to scale, but NOT running now. It requests zero GPU while at 0.
        #
        # GPU SWAP IS MANUAL: only ONE model can hold the single 96GB GPU at a time. To
        # actually serve Muse you MUST first scale qwen27 above to replicaCount: 0 (and
        # apps/vllm.yaml's vllm-qwen27 must already be 0) — otherwise the second engine
        # double-allocs the GPU and OOMs. This entry does NOT enforce that; it's a
        # deliberate manual swap.
        #
        # The vllm/vllm-openai:muse-glimmer image tag + muse_glimmer tool/reasoning
        # parsers come from the Muse serving recipe. Their availability gets validated at
        # the FIRST real scale-up — this at-0 entry is not exercised until then.
        - name: muse-glimmer
          enabled: true
          replicaCount: 0            # scaled to zero: ready-to-scale, requests no GPU
          repository: "vllm/vllm-openai"
          tag: "muse-glimmer"        # Muse-specific vLLM image tag
          modelURL: "RedHatAI/Muse-Glimmer-30B-NVFP4"
          runtimeClassName: "nvidia"
          requestGPU: 1
          requestCPU: 4
          requestMemory: "24Gi"
          pvcStorage: "70Gi"         # ~17GB NVFP4 text weights + BF16 vision tower/embeddings/lm_head
          storageClass: "local-path"
          shmSize: "16Gi"
          enableLoRA: false          # FOOTGUN: chart defaults true -> injects --enable-lora + sidecar
          hf_token:
            secretName: "hf-token"
            secretKey: "HF_TOKEN"
          keda:
            enabled: false           # manual, no autoscaling
          vllmConfig:
            # Muse is a DENSE Gemma2-derived multimodal model (NOT hybrid/Mamba) — so no
            # --mamba-cache-dtype args (those are Qwen-only). --kv-cache-dtype intentionally
            # left unset for first bringup (let it default) to reduce risk.
            enablePrefixCaching: false   # conservative first bringup (sliding-window/iRoPE)
            maxModelLen: 8192            # start short per quant handoff; raise later
            gpuMemoryUtilization: 0.90
            extraArgs:
              # --enforce-eager: same fix as qwen27 — SM120 27B+ CUDA-graph compile
              # overruns the chart's 10-min startup probe -> SIGKILL loop; eager loads
              # fast enough to pass the probe.
              - "--enforce-eager"
              - "--trust-remote-code"
              - "--enable-auto-tool-choice"
              - "--tool-call-parser"
              - "muse_glimmer"
              - "--reasoning-parser"
              - "muse_glimmer"
              - "--generation-config"
              - "auto"
              - "--served-model-name"
              - "muse"
              - "muse-glimmer"
          env:
            # Override the service-link env the `vllm` Service injects as
            # VLLM_PORT=tcp://...:80 (which vLLM misreads as its port -> crash). Same
            # reason as qwen27. 8000 is vLLM's default API port.
            - name: VLLM_PORT
              value: "8000"
            - name: VLLM_ATTENTION_BACKEND
              value: "FLASHINFER"       # SM120: required on v0.26.x
            - name: FLASHINFER_CUDA_ARCH_LIST
              value: "12.0f"            # SM120 targeting
            # MoE-only vars (VLLM_USE_FLASHINFER_MOE_MXFP4_MXFP8 / VLLM_FLASHINFER_MOE_BACKEND)
            # intentionally OMITTED — Muse is dense, not MoE.
    routerSpec:
      enableRouter: true
      serviceType: ClusterIP
      routingLogic: "roundrobin"
      serviceMonitor:
        enabled: false   # no Prometheus-operator ServiceMonitor CRD on this cluster; vLLM still exposes /metrics
