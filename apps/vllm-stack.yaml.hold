# =============================================================================
# vLLM Production Stack — STAGED DRAFT (.yaml.hold, Flux IGNORES this file)
# =============================================================================
# Plan + rationale: GitHub issue #66. Decision: adopt in SWAP mode (Laguna ~72GB
# + Qwen ~14GB can't co-reside on 96GB — one model up at a time, router stays up,
# idle model at replicaCount 0). This file is prep only; DO NOT un-hold until the
# OPEN ITEMS below are resolved and you're ready for the disruptive cutover.
#
# ---- OPEN ITEMS BEFORE CUTOVER (see #66) -----------------------------------
# 1. MODEL CACHE / PVC: as written the chart creates FRESH local-path PVCs and
#    will RE-DOWNLOAD models — Laguna is ~72GB! Before cutover, decide: either
#    (a) reuse our existing caches (vllm-models / laguna-models-nvme) via
#    extraVolumes+extraVolumeMounts at /data + HF_HOME, skipping the chart PVC, or
#    (b) accept the one-time re-download. Current draft = fresh PVCs (simplest).
# 2. LAGUNA VERSION: draft pins v0.25.1 (known-good). Per #66 we want to TRY
#    unifying on v0.26.0 — gated on a validation spike (Laguna + env
#    VLLM_ATTENTION_BACKEND=FLASHINFER + FlashInfer trio re-pinned to 0.6.14).
#    If the spike passes: flip Laguna repository/tag to v0.26.0, add that env,
#    change the initContainer trio to the 0.6.14 line. Until then: v0.25.1.
# 3. LAGUNA BOOTSTRAP: uses the fragile initContainer+PVC+PYTHONPATH path (per
#    the "runtime bootstrap in-chart" choice — the chart's main command is
#    hardcoded so we can't prepend pip). If it fights us, bake a custom image
#    (ghcr.io/dbirks/laguna-vllm with the trio preinstalled) and point tag at it.
# 4. MONITORING LABELS: our Prometheus serviceMonitorSelector looked empty
#    (scrape-all) and Grafana runs a grafana-sc-dashboard sidecar. Confirm the
#    exact label the sidecar watches; adjust grafanaDashboards.labels if needed.
# 5. INGRESS: at cutover, repoint vllm.hoam.lan / laguna.hoam.lan from svc/laguna
#    to the router service, and scale down / .hold apps/vllm.yaml + laguna-vllm.yaml.
# 6. SWAP TOGGLE: draft starts Qwen up (replicaCount 1) / Laguna down (0). Flip
#    per which model you want serving. KEDA is disabled (manual swap).
# =============================================================================
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: vllm-production-stack
  namespace: flux-system
spec:
  interval: 1h
  url: https://vllm-project.github.io/production-stack
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: vllm-stack
  namespace: default
spec:
  interval: 10m
  timeout: 45m   # first engine init + model load is slow
  chart:
    spec:
      chart: vllm-stack
      version: "0.1.12"   # latest as of 2026-07-24; pin deliberately, no `latest`
      sourceRef:
        kind: HelmRepository
        name: vllm-production-stack
        namespace: flux-system
      interval: 1h
  # Default values: https://github.com/vllm-project/production-stack/blob/vllm-stack-0.1.12/helm/values.yaml
  values:
    servingEngineSpec:
      enableEngine: true
      runtimeClassName: "nvidia"   # GPU workloads require it (exists on our node)
      # Recreate: never run old+new engine pods at once — on ONE shared GPU an
      # overlapping rollout double-allocates VRAM and OOMs (chart default surges).
      strategy:
        type: Recreate
      serviceMonitor:
        enabled: true
        additionalLabels: {}   # TODO(#66): our Prom SM-selector looked empty (scrape-all); confirm

      modelSpec:
        # ---------------------------------------------------------------------
        # Qwen3.6-27B-NVFP4 (coding LLM) + DFlash. ~14GB weights.
        # ---------------------------------------------------------------------
        - name: qwen27
          enabled: true
          replicaCount: 1          # SWAP: this one UP by default
          repository: "vllm/vllm-openai"
          tag: "v0.26.0"           # Qwen validated on v0.26.0
          modelURL: "unsloth/Qwen3.6-27B-NVFP4"
          runtimeClassName: "nvidia"
          requestGPU: 1            # one time-slice of the shared GPU
          requestCPU: 4
          requestMemory: "24Gi"
          pvcStorage: "60Gi"       # TODO(#66) item 1: fresh PVC = re-download
          storageClass: "local-path"
          shmSize: "16Gi"
          enableLoRA: false        # FOOTGUN: chart defaults true -> injects --enable-lora + sidecar
          hf_token:
            secretName: "hf-token"
            secretKey: "HF_TOKEN"
          keda:
            enabled: false         # manual swap, not autoscaling
          vllmConfig:
            # NB: omit `v0` entirely -> V1 engine (v0:"1" would force legacy V0!)
            enablePrefixCaching: false   # hybrid-attention GDN bug (-> --no-enable-prefix-caching)
            maxModelLen: 16384
            gpuMemoryUtilization: 0.88   # set HERE only, never also in extraArgs (dup flag)
            extraArgs:
              - "--kv-cache-dtype"
              - "fp8_e4m3"
              - "--mamba-cache-dtype"
              - "float16"
              - "--mamba-ssm-cache-dtype"
              - "float16"
              - "--trust-remote-code"
              - "--served-model-name"
              - "main"
              - "qwen27"
              - "--speculative-config"
              - '{"method":"dflash","model":"z-lab/Qwen3.6-27B-DFlash","num_speculative_tokens":15}'
          env:
            - name: VLLM_USE_FLASHINFER_MOE_MXFP4_MXFP8
              value: "1"
            - name: VLLM_FLASHINFER_MOE_BACKEND
              value: "latency"
            - name: FLASHINFER_CUDA_ARCH_LIST
              value: "12.0f"

        # ---------------------------------------------------------------------
        # Laguna-S-2.1-NVFP4 (agentic-coding MoE) + DFlash K=7. ~72GB weights.
        # ---------------------------------------------------------------------
        - name: laguna
          enabled: true
          replicaCount: 0          # SWAP: this one DOWN by default (flip to swap)
          repository: "vllm/vllm-openai"
          tag: "v0.25.1"           # known-good; v0.26.0 crashes (SM120 cutedsl) until spike passes (#66 item 2)
          modelURL: "poolside/Laguna-S-2.1-NVFP4"
          runtimeClassName: "nvidia"
          requestGPU: 1
          requestCPU: 4
          requestMemory: "24Gi"
          pvcStorage: "160Gi"      # ~72GB model + cache; TODO(#66) item 1: fresh PVC = re-download 72GB!
          storageClass: "local-path"
          shmSize: "20Gi"
          enableLoRA: false
          enableTool: true                 # -> --enable-auto-tool-choice
          toolCallParser: "poolside_v1"    # -> --tool-call-parser poolside_v1
          hf_token:
            secretName: "hf-token"
            secretKey: "HF_TOKEN"
          keda:
            enabled: false
          # FRAGILE bootstrap (see #66 item 3): pip-install the FlashInfer trio
          # onto the shared /data PVC, then PYTHONPATH it into the main container.
          # For v0.25.1 use the 0.6.15.dev trio; for a v0.26.0 flip use 0.6.14.
          initContainer:
            name: "flashinfer-bootstrap"
            image: "vllm/vllm-openai:v0.25.1"   # match main image so the wheels line up
            command: ["/bin/sh", "-c"]
            args:
              - |
                set -e
                pip install --no-deps --target=/data/pylibs \
                  flashinfer-python==0.6.15.dev20260712 \
                  flashinfer-cubin==0.6.15.dev20260712 \
                  flashinfer-jit-cache==0.6.15.dev20260712+cu130 \
                  --extra-index-url https://flashinfer.ai/whl/nightly/ \
                  --extra-index-url https://flashinfer.ai/whl/nightly/cu130/
            mountPvcStorage: true            # mounts the model PVC at /data
          vllmConfig:
            # omit `v0` -> V1 engine
            enablePrefixCaching: true        # -> --enable-prefix-caching
            enableChunkedPrefill: true       # -> --enable-chunked-prefill
            maxModelLen: 131072              # proven today at util 0.85
            maxNumSeqs: 4                    # DFlash crashes at the default 256
            gpuMemoryUtilization: 0.85
            extraArgs:
              - "--moe-backend"
              - "marlin"
              - "--kernel-config"
              - '{"enable_cutedsl_warmup": false, "enable_flashinfer_autotune": false}'
              - "--reasoning-parser"
              - "poolside_v1"
              - "--served-model-name"
              - "main"
              - "laguna"
              - "--default-chat-template-kwargs"
              - '{"enable_thinking": true}'
              - "--speculative-config"
              - '{"model":"poolside/Laguna-S-2.1-DFlash-NVFP4","num_speculative_tokens":7,"method":"dflash"}'
              - "--trust-remote-code"
          env:
            - name: PYTHONPATH               # pick up the bootstrapped trio
              value: "/data/pylibs"
            # When flipping to v0.26.0 (spike-gated), add:
            # - name: VLLM_ATTENTION_BACKEND
            #   value: "FLASHINFER"

    routerSpec:
      enableRouter: true
      serviceType: ClusterIP     # front with our private/public ingress at cutover
      routingLogic: "roundrobin" # prefix/kvaware are pointless with 1 replica/model
      serviceMonitor:
        enabled: true
        additionalLabels: {}     # TODO(#66): same as engine SM

    # We already run Prometheus + Grafana — use them, don't bundle new ones.
    grafanaDashboards:
      enabled: true
      labels:
        grafana_dashboard: "1"   # TODO(#66): confirm grafana-sc-dashboard sidecar's watch label
    kube-prometheus-stack:
      enabled: false
    prometheus-adapter:
      enabled: false
