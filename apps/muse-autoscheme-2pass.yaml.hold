# AutoScheme mixed-NVFP4 for Muse-Glimmer-30B — TWO-PASS to beat the export host-RAM OOM (NO publish yet).
# Root cause (auto-round research, PR #2105): AutoScheme retains ~1.1-1.5x BF16 host RAM through the final
# quantize_and_save, OOM-killing the 48GB node. Fix: DECOUPLE. Pass 1 scores + returns layer_config (no
# save -> no OOM), pickled. Pass 2 (fresh process) applies that layer_config via PLAIN AutoRound (the same
# ~25GB path the uniform quant used) + low_cpu_mem_usage immediate-save. The "mixed data_types can't export"
# warning is stale/non-blocking — export_to_fp.py detects mixed (bits,data_type) groups -> format mixed-precision.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: muse-autoscheme-2pass-scripts
  namespace: default
data:
  run.sh: |
    #!/bin/bash
    set -uo pipefail
    PY="$(command -v python3 || command -v python)"
    export HF_HOME=/workspace/hf PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
    export AR_ENABLE_AUTO_SCHEME_PARALLEL=0        # serial scoring (parallel forks fail in-container)
    export AR_AUTO_SCHEME_BATCH_SIZE=1
    export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
    # NOTE: AR_DISK_STREAM_MODEL=1 conflicts with low_gpu_mem_usage=False (meta-tensor .to()). Instead,
    # Pass 1 INTERCEPTS AutoScheme's get_layer_config return and aborts before the OOMing quantize/pack.
    mkdir -p /workspace/artifacts /workspace/runs "$HF_HOME"
    command -v git >/dev/null 2>&1 || (apt-get update -qq && apt-get install -y -qq git) >/dev/null 2>&1 || true
    echo "=== [$(date)] installing auto-round fork + transformers-from-source ==="
    "$PY" -m pip install --no-cache-dir "auto-round @ git+https://github.com/dbirks/auto-round.git@main" datasets accelerate 2>&1 | tail -6
    "$PY" -m pip install --no-cache-dir --upgrade "git+https://github.com/huggingface/transformers.git" 2>&1 | tail -4
    "$PY" -c "import auto_round,transformers; print('auto_round',auto_round.__version__,'transformers',transformers.__version__)"
    echo "=== [$(date)] PASS 1: AutoScheme scoring -> pickle layer_config ==="
    "$PY" /scripts/pass1.py || { echo "PASS1 FAILED"; exit 1; }
    echo "=== [$(date)] PASS 2: fresh process, apply layer_config -> export ==="
    "$PY" /scripts/pass2.py
  common.py: |
    import os
    AVG   = float(os.environ.get("AVG_BITS", "4.75"))
    ITERS = int(os.environ.get("ITERS", "0"))
    NSAMP = int(os.environ.get("NSAMPLES", "8"))
    SEQLEN = int(os.environ.get("SEQLEN", "512"))
    CALIB = "NeelNanda/pile-10k"
    PKL   = f"/workspace/artifacts/muse-layer-config-avg{AVG}.pkl"
    OUT   = f"/workspace/runs/muse-autoscheme-avg{AVG}"
    SHARED = [["q_proj", "k_proj", "v_proj"], ["gate_proj", "up_proj"]]
    def resolve_model():
        m = os.environ.get("MUSE_MODEL", "meta-models/Muse-Glimmer-30B")
        if not os.path.isdir(m):
            from huggingface_hub import snapshot_download
            m = snapshot_download(m)
        return m
    def patch_reentrant_checkpoint():
        # non-reentrant recompute metadata mismatches on Muse -> force reentrant (keeps mem savings, skips validation)
        import torch, torch.utils.checkpoint as _ckpt
        _orig = _ckpt.checkpoint
        def _re(function, *a, use_reentrant=None, **k): return _orig(function, *a, use_reentrant=True, **k)
        _ckpt.checkpoint = _re; torch.utils.checkpoint.checkpoint = _re
  pass1.py: |
    #!/usr/bin/env python3
    # Capture AutoScheme's chosen layer_config by INTERCEPTING get_layer_config (which runs during scoring,
    # and completes fine — the OOM is only in the downstream quantize/pack). Dump it and abort before the pack.
    import pickle, sys, importlib
    sys.path.insert(0, "/scripts"); import common as C
    C.patch_reentrant_checkpoint()
    import torch  # noqa
    MODEL = C.resolve_model()

    class _Captured(BaseException):   # BaseException so the MLLM `except Exception` can't swallow it
        pass
    # Patch configure_layer_config on whatever compressor class defines it; after it runs, self.layer_config
    # is the final AutoScheme assignment. Dump it + abort before the OOMing quantize/pack.
    # Patch _gen_auto_scheme (returns the assignment) — one frame BEFORE configure_layer_config applies it
    # and OOMs. Capture its return (or self.layer_config), abort before the apply.
    TARGET = "_gen_auto_scheme"
    import auto_round.compressors.base as B
    Cls = next((getattr(B, n) for n in dir(B)
                if isinstance(getattr(B, n), type) and TARGET in getattr(B, n).__dict__), None)
    if Cls is None:
        raise RuntimeError(f"could not find {TARGET} to patch")
    print("patching", Cls.__name__ + "." + TARGET, flush=True)
    _orig_gas = getattr(Cls, TARGET)
    def _cap(self, *a, **k):
        ret = _orig_gas(self, *a, **k)
        lc = ret if (isinstance(ret, dict) and ret) else getattr(self, "layer_config", None)
        if lc and isinstance(lc, dict):
            pickle.dump(lc, open(C.PKL, "wb"))
            from collections import Counter
            dts = Counter((v.get("data_type"), v.get("bits")) for v in lc.values() if isinstance(v, dict))
            print("PASS1 layer_config captured ->", C.PKL, "| scheme counts:", dict(dts), flush=True)
            raise _Captured()
        print("WARN: _gen_auto_scheme returned no layer_config dict; continuing", flush=True)
        return ret
    setattr(Cls, TARGET, _cap)

    from auto_round import AutoRound, AutoScheme
    from transformers import AutoConfig
    cfg = AutoConfig.from_pretrained(MODEL, trust_remote_code=True)
    print(f"PASS1 avg_bits={C.AVG} model_type={getattr(cfg,'model_type',None)}", flush=True)
    def make():
        scheme = AutoScheme(avg_bits=C.AVG, options=("NVFP4", "MXFP8"), shared_layers=C.SHARED,
                            nsamples=C.NSAMP, low_gpu_mem_usage=False)
        return AutoRound(MODEL, scheme=scheme, dataset=C.CALIB, nsamples=C.NSAMP, seqlen=C.SEQLEN,
                         iters=C.ITERS, batch_size=4, device_map=0, trust_remote_code=True,
                         quant_nontext_module=False, seed=42)
    def run():
        try:
            ar = make()
        except Exception as e:            # MLLM template registration (won't catch _Captured — it's BaseException)
            print("MLLM template register:", repr(e)[:200], flush=True)
            for tmod, pmod in [("auto_round.mllm.template","auto_round.mllm.processor"),
                               ("auto_round.compressors.mllm.template","auto_round.compressors.mllm.processor")]:
                try:
                    importlib.import_module(tmod)._register_template(model_type=cfg.model_type, default_dataset=C.CALIB,
                        processor=importlib.import_module(pmod).PROCESSORS["hf"]); break
                except Exception: continue
            ar = make()
        ar.quantize()   # triggers scoring -> get_layer_config -> capture -> _Captured
    try:
        run()
    except _Captured:
        print("PASS1 DONE (captured layer_config, aborted before pack)", flush=True)
  pass2.py: |
    #!/usr/bin/env python3
    import pickle, json, sys
    from pathlib import Path
    sys.path.insert(0, "/scripts"); import common as C
    import torch  # noqa
    MODEL = C.resolve_model()
    layer_config = pickle.load(open(C.PKL, "rb"))
    from auto_round import AutoRound
    # Fresh AutoRound with the fixed mixed layer_config; NVFP4 default group. low_cpu_mem_usage=immediate save.
    ar = AutoRound(MODEL, scheme="NVFP4", layer_config=layer_config, iters=0, batch_size=4,
                   device_map=0, trust_remote_code=True, quant_nontext_module=False, seed=42,
                   low_cpu_mem_usage=True)
    _, saved = ar.quantize_and_save(output_dir=C.OUT, format="llm_compressor")
    def find_cfg(base):
        base = Path(base)
        if (base / "config.json").is_file(): return base
        for p in sorted(base.rglob("config.json")): return p.parent
        return None
    cand = saved[0] if isinstance(saved, (list, tuple)) else saved
    d = find_cfg(cand) or find_cfg(C.OUT)
    c = json.loads((d / "config.json").read_text())
    qc = c.get("quantization_config") or {}
    groups = qc.get("config_groups") or {}
    sizes = {f"{g}(w{ (v.get('weights') or {}).get('num_bits') })": len(v.get("targets") or []) for g,v in groups.items()}
    total = sum(f.stat().st_size for f in Path(d).rglob("*") if f.is_file())
    summ = {"avg_bits": C.AVG, "out": str(d), "format": qc.get("format"), "n_groups": len(groups),
            "group_sizes": sizes, "size_gb": round(total/1024**3, 2)}
    Path(f"/workspace/artifacts/autoscheme-avg{C.AVG}-summary.json").write_text(json.dumps(summ, indent=2))
    print("PASS2 SUMMARY", json.dumps(summ, indent=2), flush=True)
    print("PASS2 DONE — mixed export complete", flush=True)
---
apiVersion: batch/v1
kind: Job
metadata:
  name: muse-autoscheme-2pass-avg475e-20260812
  namespace: default
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 172800
  template:
    metadata:
      labels: { app: muse-autoscheme-2pass }
    spec:
      restartPolicy: Never
      runtimeClassName: nvidia
      enableServiceLinks: false
      tolerations:
        - key: node.kubernetes.io/disk-pressure
          operator: Exists
          effect: NoSchedule
      containers:
        - name: quant
          image: vllm/vllm-openai:v0.26.0
          command: ["/bin/bash", "/scripts/run.sh"]
          env:
            - { name: HF_TOKEN, valueFrom: { secretKeyRef: { name: hf-write-token, key: HF_TOKEN } } }
            - { name: AVG_BITS, value: "4.75" }
            - { name: ITERS, value: "0" }
            - { name: NSAMPLES, value: "8" }
            - { name: SEQLEN, value: "512" }
          resources:
            limits:
              nvidia.com/gpu: 1
          volumeMounts:
            - { name: workspace, mountPath: /workspace }
            - { name: scripts, mountPath: /scripts }
            - { name: shm, mountPath: /dev/shm }
      volumes:
        - { name: workspace, persistentVolumeClaim: { claimName: muse-quant-workspace } }
        - { name: scripts, configMap: { name: muse-autoscheme-2pass-scripts } }
        - { name: shm, emptyDir: { medium: Memory, sizeLimit: 8Gi } }
