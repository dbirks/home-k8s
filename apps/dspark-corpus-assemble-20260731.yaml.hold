# CPU-only corpus assembler — combines the tokenized sources + our passthrough
# on-policy regen into the final coding-weighted training corpus for the big
# 3-layer block-16 run. Writes /dataset/combined-v1/all.jsonl + regen.done so
# the existing trainer (which cleans -> all_clean.jsonl -> prepare_data) can
# consume it unchanged.
#
# NOT auto-applied — launch when the coding regen has matured (~30k) and the
# weights below are confirmed. Tunables live at the top of assemble.py.
apiVersion: v1
kind: ConfigMap
metadata:
  name: dspark-corpus-assemble-20260731-script
  namespace: default
data:
  assemble.py: |
    #!/usr/bin/env python3
    """Assemble the final training corpus from tokenized sources + passthrough.

    - filter Chinese/refusal tail from Avesed (decode supervised span, CJK ratio)
    - downsample osieosie agentic (huge contexts, ~1% supervised -> compute sink)
    - upweight our on-policy coding regen (highest value for a coding drafter)
    - concat + global shuffle -> all.jsonl + regen.done
    """
    import argparse, glob, hashlib, json, os, random, statistics as st
    from multiprocessing import Pool

    # ---------------- tunables ----------------
    OSIEOSIE_CAP = 20000     # agentic tail size (of ~196k)
    CODING_UPWEIGHT = 2      # replicate our on-policy coding regen N times
    DROP_CJK_FRAC = 0.30     # drop Avesed rows whose answer is >30% CJK
    MAXLEN = 12288           # hard cap (trainer packs at 4096; keep some slack)
    SEED = 1337
    # ------------------------------------------

    TOK = None
    def _init(model):
        global TOK
        from transformers import AutoTokenizer
        TOK = AutoTokenizer.from_pretrained(model, trust_remote_code=True)

    CJK = [(0x4E00,0x9FFF),(0x3400,0x4DBF),(0x20000,0x2A6DF),(0x3040,0x30FF),
           (0xAC00,0xD7AF)]
    def _cjk_frac_of_supervised(row):
        ids = row["input_ids"]; mk = row["loss_mask"]
        sup = [t for t, b in zip(ids, mk) if b]
        if not sup: return 1.0
        txt = TOK.decode(sup, skip_special_tokens=True)
        if not txt: return 1.0
        c = sum(1 for ch in txt if any(a <= ord(ch) <= b for a, b in CJK))
        letters = sum(1 for ch in txt if ch.isalnum() or any(a <= ord(ch) <= b for a, b in CJK))
        return c / max(1, letters)

    def _cjk_keep(row):
        try:
            return row if _cjk_frac_of_supervised(row) <= DROP_CJK_FRAC else None
        except Exception:
            return row

    def _load(path):
        rows = []
        for line in open(path):
            line = line.strip()
            if not line: continue
            try:
                r = json.loads(line)
            except Exception:
                continue
            if "input_ids" not in r or "loss_mask" not in r: continue
            if len(r["input_ids"]) > MAXLEN: continue
            rows.append({"input_ids": r["input_ids"], "loss_mask": r["loss_mask"]})
        return rows

    def main():
        ap = argparse.ArgumentParser()
        ap.add_argument("--model", required=True)
        ap.add_argument("--combined", default="/dataset/combined-v1")
        ap.add_argument("--coding-glob", default="/dataset/onpolicy-coding-v1/regen_*.jsonl")
        ap.add_argument("--procs", type=int, default=min(16, os.cpu_count() or 8))
        a = ap.parse_args()
        rng = random.Random(SEED)
        C = a.combined
        comp = {}          # name -> kept count
        suptok = {}        # name -> supervised tokens
        pool = Pool(a.procs, _init, (a.model,))
        out_path = os.path.join(C, "all.jsonl")
        seen = set()
        kept_total = 0
        with open(out_path, "w") as out:
            def emit(name, rows, reps=1):
                nonlocal kept_total
                k = 0; stk = 0
                for _ in range(reps):
                    for r in rows:
                        h = hashlib.sha1((",".join(map(str, r["input_ids"]))).encode()).hexdigest()
                        # allow intended duplicates from upweighting (reps>1) but
                        # dedup within a single pass
                        if reps == 1 and h in seen: continue
                        seen.add(h)
                        out.write(json.dumps(r) + "\n")
                        k += 1; stk += sum(r["loss_mask"]); kept_total += 1
                comp[name] = comp.get(name, 0) + k
                suptok[name] = suptok.get(name, 0) + stk
                print(f"  emit {name}: +{k} rows ({stk/1e6:.1f}M sup tok)", flush=True)

            # --- Avesed base + pb: CJK/refusal filter ---
            for name in ("avesed_general", "avesed_pb"):
                f = os.path.join(C, f"tok_{name}.jsonl")
                if not os.path.exists(f): continue
                rows = _load(f)
                filt = [r for r in pool.imap_unordered(_cjk_keep, rows, chunksize=64) if r]
                print(f"  {name}: {len(rows)} -> {len(filt)} after CJK<= {DROP_CJK_FRAC}", flush=True)
                emit(name, filt)

            # --- coding sources: keep all ---
            for name in ("satgeze", "ctest", "sleepyeldrazi"):
                f = os.path.join(C, f"tok_{name}.jsonl")
                if os.path.exists(f): emit(name, _load(f))

            # --- osieosie agentic: downsample ---
            f = os.path.join(C, "tok_osieosie.jsonl")
            if os.path.exists(f):
                rows = _load(f); rng.shuffle(rows)
                emit("osieosie", rows[:OSIEOSIE_CAP])

            # --- our on-policy coding regen: upweight ---
            coding = []
            for f in sorted(glob.glob(a.coding_glob)):
                coding += _load(f)
            if coding:
                emit("coding_regen", coding, reps=CODING_UPWEIGHT)

        pool.close()
        # global shuffle so sources interleave
        print("  shuffling...", flush=True)
        lines = open(out_path).readlines()
        rng.shuffle(lines)
        with open(out_path, "w") as out:
            out.writelines(lines)
        open(os.path.join(C, "regen.done"), "w").close()

        print("\n=== FINAL CORPUS COMPOSITION ===", flush=True)
        tot = sum(comp.values()); tots = sum(suptok.values())
        for name in comp:
            print(f"  {name:16s} {comp[name]:>7d} rows ({100*comp[name]/tot:4.1f}%) | "
                  f"{suptok[name]/1e6:6.1f}M sup tok ({100*suptok[name]/tots:4.1f}%)")
        print(f"  {'TOTAL':16s} {tot:>7d} rows | {tots/1e6:.1f}M supervised tokens")
        print(f"  written: {out_path} (+ regen.done)")

    if __name__ == "__main__":
        main()
  run.sh: |
    #!/bin/bash
    set -uo pipefail
    MODEL=unsloth/Qwen3.6-27B-NVFP4
    export HF_HUB_ENABLE_HF_TRANSFER=1
    echo "[$(date)] installing deps..."
    pip install --quiet --no-cache-dir transformers tokenizers jinja2 huggingface_hub hf_transfer || exit 1
    echo "[$(date)] === assembling combined corpus ==="
    python3 /scripts/assemble.py --model "$MODEL" 2>&1 | tee /output/logs/assemble.log
    echo "[$(date)] assembly done."
    sleep 3600
---
apiVersion: batch/v1
kind: Job
metadata:
  name: dspark-corpus-assemble-20260731
  namespace: default
spec:
  backoffLimit: 2
  template:
    metadata:
      labels:
        job-name: dspark-corpus-assemble-20260731
    spec:
      restartPolicy: Never
      containers:
        - name: assemble
          image: python:3.11-slim
          command: ["/bin/bash", "/scripts/run.sh"]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            seccompProfile:
              type: RuntimeDefault
          resources:
            requests:
              cpu: "4"
              memory: 6Gi
            limits:
              cpu: "16"
              memory: 16Gi
          volumeMounts:
            - name: dataset
              mountPath: /dataset
            - name: output
              mountPath: /output
            - name: scripts
              mountPath: /scripts
      volumes:
        - name: dataset
          persistentVolumeClaim:
            claimName: dspark-dataset-hdd
        - name: output
          persistentVolumeClaim:
            claimName: dspark-output-hdd-v2
        - name: scripts
          configMap:
            name: dspark-corpus-assemble-20260731-script
